<Page
    x:Class="Ghost.AssetForge.Views.PackingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Ghost.Core"
    xmlns:local="using:Ghost.AssetForge.Views"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodels="using:Ghost.AssetForge.ViewModels"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <local:NullToVisibilityConverter x:Key="NullToCollapsedConverter" IsInverse="True" />
        <local:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter" />
    </Page.Resources>

    <Grid>
        <!--  Main Workspace: Always drawn underneath, no conditional visibility  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Left Pane: Configuration  -->
            <ScrollViewer
                Grid.Column="0"
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="20">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontFamily="Segoe UI Variable"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Build Configuration" />

                    <!--  Group 1: General Build  -->
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="General Options" />

                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Output Directory" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay}" />
                                    <Button
                                        Grid.Column="1"
                                        Width="36"
                                        Height="36"
                                        Click="BrowseOutputFolder_Click"
                                        Content="&#xE8B5;"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  Group 2: Packing Settings  -->
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="12">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Packing Options" />

                            <StackPanel x:Name="PackingSettingsPanel" Spacing="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!--  Splitter  -->
            <sizers:GridSplitter
                Grid.Column="1"
                Background="Transparent"
                ResizeBehavior="BasedOnAlignment" />

            <!--  Right Pane: Progress & Console  -->
            <Grid Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> 
                    <!--  Build Progress Header & Stats  -->
                    <RowDefinition Height="Auto" /> 
                    <!--  Console Toolbar  -->
                    <RowDefinition Height="*" />    
                    <!--  Console Log Messages  -->
                    <RowDefinition Height="Auto" /> 
                    <!--  Actions Panel  -->
                </Grid.RowDefinitions>

                <!--  Progress & Stats Header  -->
                <StackPanel
                    Grid.Row="0"
                    Padding="24,24,24,12"
                    Spacing="8">
                    <TextBlock
                        FontFamily="Segoe UI Variable"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="Build Progress" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Cooked: " />
                            <Run Text="{x:Bind ViewModel.CookedCount, Mode=OneWay}" />
                            <Run Text="/" />
                            <Run Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" />
                            <Run Text="  |  Packed: " />
                            <Run Text="{x:Bind ViewModel.PackedCount, Mode=OneWay}" />
                            <Run Text="/" />
                            <Run Text="{x:Bind ViewModel.TotalCount, Mode=OneWay}" />
                            <Run Text="  |  Elapsed: " />
                            <Run Text="{x:Bind ViewModel.ElapsedTimeString, Mode=OneWay}" />
                            <Run Text="  |  Remaining: " />
                            <Run Text="{x:Bind ViewModel.RemainingTimeString, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                    <ProgressBar
                        Height="6"
                        HorizontalAlignment="Stretch"
                        Maximum="100"
                        Minimum="0"
                        Value="{x:Bind ViewModel.ProgressPercent, Mode=OneWay}" />
                </StackPanel>

                <!--  Console Toolbar  -->
                <Grid Grid.Row="1" Padding="24,12,24,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Variable"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="Console Log" />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            Width="32"
                            Height="32"
                            Padding="2"
                            Click="CopyLog_Click"
                            Content="&#xE8C8;"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            ToolTipService.ToolTip="Copy Log" />
                        <Button
                            Width="32"
                            Height="32"
                            Padding="2"
                            Command="{x:Bind ViewModel.ClearConsoleCommand}"
                            Content="&#xE74D;"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            ToolTipService.ToolTip="Clear Console" />
                    </StackPanel>
                </Grid>

                <!--  Log list  -->
                <ListView
                    x:Name="ConsoleListView"
                    Grid.Row="2"
                    Margin="24,4,24,12"
                    Background="#1E1E1E"
                    CornerRadius="4"
                    ItemsSource="{x:Bind ViewModel.LogMessages, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="8,2,8,2" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:LogMessage">
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="12"
                                Foreground="{Binding Converter={StaticResource LogLevelToBrushConverter}}"
                                Text="{x:Bind ToString()}"
                                TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--  Actions Panel  -->
                <Border
                    Grid.Row="3"
                    Padding="24,16"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Height="36"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.StopBuildCommand}"
                            Content="Stop Build"
                            IsEnabled="{x:Bind ViewModel.IsBuilding, Mode=OneWay}" />
                        <Button
                            Grid.Column="1"
                            Height="36"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.RunBuildCommand}"
                            Content="Run Build"
                            IsEnabled="{x:Bind ViewModel.CanBuild, Mode=OneWay}"
                            Style="{ThemeResource AccentButtonStyle}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
