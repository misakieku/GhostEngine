<Page
    x:Class="Ghost.AssetForge.Views.ProjectExplorerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ghost.AssetForge.Views"
    xmlns:sizers="using:CommunityToolkit.WinUI.Controls"
    xmlns:viewmodels="using:Ghost.AssetForge.ViewModels"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <local:NullToVisibilityConverter x:Key="NullToCollapsedConverter" IsInverse="True" />
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <local:BoolToVisibilityConverter x:Key="BoolToCollapsedConverter" IsInverse="True" />
        <local:ItemCountConverter x:Key="ItemCountConverter" />
    </Page.Resources>

    <Grid>
        <!--  Main Workspace when project is loaded  -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>


            <!--  Left Pane: Project Tree  -->
            <Grid Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="16,16,16,8"
                    FontFamily="Segoe UI Variable"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Project" />
                <TreeView
                    x:Name="FolderTreeView"
                    Grid.Row="1"
                    Margin="8,0"
                    ItemInvoked="FolderTreeView_ItemInvoked"
                    SelectionMode="Single" />
            </Grid>

            <!--  Resizable Splitter 1  -->
            <sizers:GridSplitter
                Grid.Column="1"
                Background="Transparent"
                ResizeBehavior="BasedOnAlignment" />

            <!--  Center Pane: Asset Browser  -->
            <Grid Grid.Column="2" Margin="16,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Toolbar  -->
                <Grid
                    Grid.Row="0"
                    Margin="0,16,0,8"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Grid.Column="0"
                        Width="36"
                        Height="36"
                        Padding="2"
                        Command="{x:Bind ViewModel.GoBackCommand}"
                        Content="&#xE0A6;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        IsEnabled="{x:Bind ViewModel.CanGoBack, Mode=OneWay}"
                        ToolTipService.ToolTip="Back" />
                    <Button
                        Grid.Column="1"
                        Width="36"
                        Height="36"
                        Padding="2"
                        Command="{x:Bind ViewModel.GoForwardCommand}"
                        Content="&#xE0AB;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        IsEnabled="{x:Bind ViewModel.CanGoForward, Mode=OneWay}"
                        ToolTipService.ToolTip="Forward" />
                    <Button
                        Grid.Column="2"
                        Width="36"
                        Height="36"
                        Padding="2"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        Content="&#xE72C;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        ToolTipService.ToolTip="Refresh" />
                    <Button
                        Grid.Column="3"
                        Width="36"
                        Height="36"
                        Padding="2"
                        Click="ImportButton_Click"
                        Content="&#xE896;"
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        ToolTipService.ToolTip="Import Assets..." />

                    <!--  Breadcrumbs  -->
                    <BreadcrumbBar
                        Grid.Column="4"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay}" />

                    <TextBox
                        Grid.Column="5"
                        Width="200"
                        Height="36"
                        PlaceholderText="Search assets"
                        Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <!--  Asset Grid  -->
                <GridView
                    x:Name="AssetGridView"
                    Grid.Row="1"
                    Padding="0,8"
                    AllowDrop="True"
                    DragOver="AssetGridView_DragOver"
                    Drop="AssetGridView_Drop"
                    ItemsSource="{x:Bind ViewModel.Assets, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedAsset, Mode=TwoWay}"
                    SelectionMode="Single">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:AssetItem">
                            <Grid
                                Width="{Binding ElementName=ZoomSlider, Path=Value}"
                                Height="{Binding ElementName=ZoomSlider, Path=Value}"
                                Margin="4">
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid Padding="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="4">
                                            <Image
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Source="{x:Bind Thumbnail, Mode=OneWay}"
                                                Stretch="UniformToFill"
                                                Visibility="{x:Bind ThumbnailVisibility, Mode=OneWay}" />
                                            <FontIcon
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                FontSize="32"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Glyph="&#xE8A5;"
                                                Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                                        </Grid>
                                        <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="Medium"
                                                Text="{x:Bind Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="9"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Format}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!--  Bottom Status Bar  -->
                <Grid Grid.Row="2" Margin="0,8,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.Assets.Count, Mode=OneWay, Converter={StaticResource ItemCountConverter}}" />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="12"
                            Glyph="&#xE7C3;" />
                        <Slider
                            x:Name="ZoomSlider"
                            Width="120"
                            VerticalAlignment="Center"
                            Maximum="200"
                            Minimum="80"
                            Value="{x:Bind ViewModel.GridItemSize, Mode=TwoWay}" />
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="16"
                            Glyph="&#xE7C3;" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!--  Resizable Splitter 2  -->
            <sizers:GridSplitter
                Grid.Column="3"
                Background="Transparent"
                ResizeBehavior="BasedOnAlignment" />

            <!--  Right Pane: Inspector  -->
            <Grid Grid.Column="4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" Padding="16">
                    <StackPanel Spacing="16">
                        <!--  If no asset is selected  -->
                        <TextBlock
                            Margin="0,32,0,0"
                            HorizontalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{ThemeResource BodyTextBlockStyle}"
                            Text="Select an asset to inspect"
                            Visibility="{x:Bind ViewModel.SelectedAsset, Converter={StaticResource NullToCollapsedConverter}, Mode=OneWay}" />

                        <!--  If asset is selected  -->
                        <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.SelectedAsset, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
                            <!--  Asset Header  -->
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Width="64"
                                    Height="64"
                                    Padding="4"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <Grid>
                                        <Image
                                            Source="{x:Bind ViewModel.SelectedAsset.Thumbnail, Mode=OneWay}"
                                            Stretch="UniformToFill"
                                            Visibility="{x:Bind ViewModel.SelectedAsset.ThumbnailVisibility, Mode=OneWay}" />
                                        <FontIcon
                                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                            FontSize="24"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xE8A5;"
                                            Visibility="{x:Bind ViewModel.SelectedAsset.FallbackVisibility, Mode=OneWay}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Text="{x:Bind ViewModel.SelectedAsset.Name, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.SelectedAsset.Format, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.SelectedAsset.FileSizeFormatted, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>

                            <MenuFlyoutSeparator />

                            <!--  Dynamic Inspector Panel  -->
                            <StackPanel x:Name="DynamicInspectorPanel" Spacing="16" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!--  Apply Button Panel  -->
                <Border
                    Grid.Row="1"
                    Padding="16"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    Visibility="{x:Bind ViewModel.SelectedAsset, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
                    <Button
                        Height="36"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.ApplySettingsCommand}"
                        Content="Apply"
                        Style="{ThemeResource AccentButtonStyle}" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
