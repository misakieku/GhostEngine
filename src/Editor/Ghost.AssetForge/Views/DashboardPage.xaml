<Page
    x:Class="Ghost.AssetForge.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ghost.AssetForge.Views"
    xmlns:viewmodels="using:Ghost.AssetForge.ViewModels"
    NavigationCacheMode="Enabled">

    <Grid Padding="24" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Welcome Header  -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock
                FontFamily="Segoe UI Variable"
                FontSize="32"
                FontWeight="SemiBold"
                Text="Welcome to Asset Baker 👏" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{ThemeResource BodyTextBlockStyle}"
                Text="Bake, compress, and pack your game assets efficiently." />
        </StackPanel>

        <!--  Cards Grid  -->
        <Grid Grid.Row="1" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Create Project  -->
            <Border
                Grid.Column="0"
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="16">
                        <TextBlock
                            FontFamily="Segoe UI Variable"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Create New Project" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Start a new project and begin baking your assets."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        Grid.Row="1"
                        Height="36"
                        HorizontalAlignment="Left"
                        Click="NewProjectButton_Click"
                        Content="+ New Project"
                        Style="{ThemeResource AccentButtonStyle}" />
                </Grid>
            </Border>

            <!--  Card 2: Recent Projects  -->
            <Border
                Grid.Column="1"
                Padding="24"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Variable"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Recent Projects" />
                    </Grid>
                    <ListView
                        Grid.Row="1"
                        Padding="0"
                        IsItemClickEnabled="True"
                        ItemClick="RecentProjectList_ItemClick"
                        ItemsSource="{x:Bind ViewModel.RecentProjects, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ProjectItem">
                                <Grid Margin="0,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon
                                        Grid.Column="0"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        FontSize="20"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Glyph="&#xED25;" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="Medium"
                                            Text="{x:Bind Name}" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Path}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{x:Bind RelativeTime}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="48" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>

            <!--  Card 3: Open & Quick Start  -->
            <Grid Grid.Column="2" RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Open Project Card  -->
                <Border
                    Grid.Row="0"
                    Padding="24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="16">
                            <TextBlock
                                FontFamily="Segoe UI Variable"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Open Project" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Open an existing project from your computer."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Row="1"
                            Height="36"
                            HorizontalAlignment="Left"
                            Click="OpenProjectButton_Click"
                            Content="Open Project" />
                    </Grid>
                </Border>

                <!--  Quick Start Card  -->
                <Border
                    Grid.Row="1"
                    Padding="24"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="16">
                        <TextBlock
                            FontFamily="Segoe UI Variable"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Quick Start" />
                        <StackPanel Spacing="12">
                            <HyperlinkButton
                                Padding="0"
                                Content="Documentation"
                                NavigateUri="https://github.com" />
                            <HyperlinkButton
                                Padding="0"
                                Content="Getting Started Guide"
                                NavigateUri="https://github.com" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
