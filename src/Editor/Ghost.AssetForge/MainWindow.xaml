<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Ghost.AssetForge.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Ghost.AssetForge"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Ghost Asset Baker"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            Title="AssetForge Studio"
            Grid.Row="0"
            Subtitle="Bake and pack for max performance" />

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            OpenPaneLength="220"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Dashboard"
                    Icon="Home"
                    Tag="Dashboard" />
                <NavigationViewItem
                    Content="Project Explorer"
                    Icon="Folder"
                    Tag="ProjectExplorer" />
                <NavigationViewItem
                    Content="Packing (Build)"
                    Icon="Library"
                    Tag="Packing" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="About" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid>
                <Frame x:Name="ContentFrame" />

                <!--  Overlay Cover when no project is loaded  -->
                <Grid
                    x:Name="NoProjectOverlay"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource SmokeFillColorDefaultBrush}"
                    Visibility="Collapsed">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="24">
                        <FontIcon
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            FontSize="72"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Glyph="&#xE8B7;" />
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="Segoe UI Variable"
                                FontSize="24"
                                FontWeight="SemiBold"
                                Style="{ThemeResource TitleTextBlockStyle}"
                                Text="No Project Open" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Open an existing project or create a new one to begin." />
                        </StackPanel>
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="16">
                            <Button
                                Height="36"
                                Click="NewProjectButton_Click"
                                Content="Create Project"
                                Style="{ThemeResource AccentButtonStyle}" />
                            <Button
                                Height="36"
                                Click="OpenProjectButton_Click"
                                Content="Open Project" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
