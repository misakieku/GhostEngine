<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Ghost.Editor.Core.Controls.ComponentExpander"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ghost.Editor.Core.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical">
        <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="4" BorderBrush="{ThemeResource ControlElevationBorderBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <ToggleButton x:Name="HeaderToggle" 
                          Grid.Column="0" 
                          HorizontalAlignment="Stretch" 
                          HorizontalContentAlignment="Left" 
                          Background="Transparent" 
                          BorderThickness="0" 
                          IsChecked="True"
                          Checked="HeaderToggle_CheckedChanged"
                          Unchecked="HeaderToggle_CheckedChanged">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="ChevronIcon" Glyph="&#xE70D;" FontSize="12" />
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>

            <Button Grid.Column="1" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    Padding="4"
                    Click="RemoveButton_Click"
                    ToolTipService.ToolTip="Remove Component">
                <FontIcon Glyph="&#xE107;" FontSize="14" />
            </Button>
        </Grid>

        <ContentPresenter x:Name="ExpandedContentPresenter" 
                          Content="{x:Bind ExpandedContent, Mode=OneWay}" 
                          Visibility="Visible"
                          Padding="12,8,12,12" />
    </StackPanel>
</UserControl>
