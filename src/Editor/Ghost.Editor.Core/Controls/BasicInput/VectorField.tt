<#@ template debug="false" hostspecific="false" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ output extension=".cs" #>
using Microsoft.UI.Xaml;
using Microsoft.UI.Xaml.Controls;
using Misaki.HighPerformance.Mathematics;

namespace Ghost.Editor.Core.Controls;

<#
var componentNames = new[] { "X", "Y", "Z", "W" };
var primitives = new[] { "float", "double", "int", "uint" };

for (int i = 0; i < primitives.Length; i++)
{
var primitive = primitives[i];
var typeName = char.ToUpper(primitive[0]) + primitive.Substring(1);
for (int j = 2; j <= 4; j++)
{ #>

<# for (int k = 0; k < j; k++) { #>
[TemplatePart(Name = "<#= componentNames[k] #>Component", Type = typeof(NumberBox))]
<# } #>
public sealed partial class <#= typeName #><#= j #>Field : ValueControl<<#= primitive #><#= j #>>
{
<# for (int k = 0; k < j; k++) { #>
    private NumberBox? _<#= componentNames[k].ToLower() #>Component;
<# } #>

    public <#= typeName #><#= j #>Field()
    {
        DefaultStyleKey = typeof(<#= typeName #><#= j #>Field);
    }

    protected override void ValueChanged(<#= primitive #><#= j #> oldValue, <#= primitive #><#= j #> newValue)
    {
        SyncFromValue();
    }

    protected override void OnApplyTemplate()
    {
        base.OnApplyTemplate();

<# for (int k = 0; k < j; k++) { #>
        _<#= componentNames[k].ToLower() #>Component?.ValueChanged -= OnComponentChanged;
        _<#= componentNames[k].ToLower() #>Component = GetTemplateChild("<#= componentNames[k] #>Component") as NumberBox;
<# } #>

        SuppressChangedEvent = true;
        SyncFromValue();
        SuppressChangedEvent = false;

<# for (int k = 0; k < j; k++) { #>
        _<#= componentNames[k].ToLower() #>Component?.ValueChanged += OnComponentChanged;
<# } #>
    }

    private void SyncFromValue()
    {
<# for (int k = 0; k < j; k++) { #>
        _<#= componentNames[k].ToLower() #>Component?.Value = Value.<#= componentNames[k].ToLower() #>;
<# } #>
    }

    private void OnComponentChanged(NumberBox sender, NumberBoxValueChangedEventArgs args)
    {
        if (SuppressChangedEvent)
        {
            return;
        }

        var newValue = new <#= primitive #><#= j #>(
<# for (int k = 0; k < j; k++) { #>
            (<#= primitive #>)(_<#= componentNames[k].ToLower() #>Component?.Value ?? 0)<#= k < j - 1 ? "," : "" #>
<# } #>
        );

        Value = newValue;
    }
}
<# } #>
<# } #>