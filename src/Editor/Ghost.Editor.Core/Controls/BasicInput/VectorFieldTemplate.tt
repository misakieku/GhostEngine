<#@ template debug="false" hostspecific="false" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ output extension=".xaml" #>
<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Ghost.Editor.Core.Controls">

<#
var componentNames = new[] { "X", "Y", "Z", "W" };
var primitives = new[] { "float", "double", "int", "uint" };

for (int i = 0; i < primitives.Length; i++)
{
var primitive = primitives[i];
var typeName = char.ToUpper(primitive[0]) + primitive.Substring(1);
for (int j = 2; j <= 4; j++)
{ #>
    <Style TargetType="local:<#= typeName #><#= j #>Field">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:<#= typeName #><#= j #>Field">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
<# for (int k = 0; k < j; k++) { #>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
<# } #>
                        </Grid.ColumnDefinitions>

<# for (int k = 0; k < j; k++) { #>
                        <TextBlock
                            Grid.Column="<#= k * 2 #>"
                            VerticalAlignment="Center"
                            Text="<#= componentNames[k] #>" />
                        <NumberBox x:Name="<#= componentNames[k] #>Component" Grid.Column="<#= k * 2 + 1 #>" />
<# } #>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
<# } #>
<# } #>
</ResourceDictionary>