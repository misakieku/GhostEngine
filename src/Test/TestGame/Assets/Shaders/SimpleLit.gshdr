shader "MyShader/SimpleLit" : "Lit"
{
    properties
    {
        uint baseColor;
        uint sampler;
        float roughness = 0.4;
    }

    strategy "DEFERREDLIGHTING_STRATEGY" "SimpleLitDeferredLighting" ("EngineResources/Shaders/Material/Lit/SimpleLit.hlsl");

    strategy "DEFERREDTEXTURING_STRATEGY" "SimpleLitDeferredTexturing"
    {
        struct SimpleLitDeferredTexturing
        {
            static SimpleLitDeferredTexturing Create()
            {
                return (SimpleLitDeferredTexturing)0;
            }

            SurfaceData GetSurfaceData(in MaterialContext ctx, in MaterialProperties props)
            {
                float3 baseColor = float3(1.0, 1.0, 1.0);
                if (IS_VALID_BUFFER(props.baseColor))
                {
                    baseColor = SAMPLE_TEXTURE2D_GRAD(props.baseColor, props.sampler, ctx.uv, ctx.ddx_uv, ctx.ddy_uv).rgb;
                }

                SurfaceData surface = (SurfaceData)0;
                surface.materialFeatures = SHADING_MODEL_ID;
                surface.albedo = baseColor;
                surface.normalWS = ctx.normalWS;
                surface.roughness = props.roughness;
                surface.metallic = 0.0;
                surface.occlusion = 1.0;
                return surface;
            }
        };
    }
}