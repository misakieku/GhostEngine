shader "MyShader/SimpleLit" : "Lit"
{
    properties
    {
        uint baseColor;
        uint sampler;
        float roughness = 0.4;
    }

    shading_model("EngineResources/Shaders/Material/Lit/SimpleLit.hlsl");

    hlsl
    {
        #if defined(GHOST_PASS_DEFERREDTEXTURING)
        #define DEFERREDTEXTURING_STRATEGY SimpleLitDeferredTexturing
        
        struct SimpleLitDeferredTexturing
        {
            static SimpleLitDeferredTexturing Create()
            {
                return (SimpleLitDeferredTexturing)0;
            }

            SurfaceData GetSurfaceData(in MaterialContext ctx, in MaterialProperties props)
            {
                SurfaceData surface = (SurfaceData)0;
                surface.materialFeatures = SHADING_MODEL_ID;
                surface.emissive = SAMPLE_TEXTURE2D_GRAD(props.baseColor, props.sampler, ctx.uv, ctx.ddx_uv, ctx.ddy_uv);
                surface.normalWS = ctx.normalWS;
                surface.roughness = props.roughness;
                surface.metallic = 0.0;
                surface.occlusion = 1.0;
                return surface;
            }
        };

        #endif // GHOST_PASS_DEFERREDTEXTURING
    }
}