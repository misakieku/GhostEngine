shader "MyShader/Standard" : "Unlit"
{
    properties
    {
        float customTintScale = 1.0;
    }

    hlsl
    {
        void GetSurfaceData(in MaterialProperties props, float2 uv, inout Payload payload, out SurfaceData surface)
        {
            surface = (SurfaceData)0;
            surface.albedo = float3(1.0, 0.0, 0.0);
            surface.emissive = float3(0.0, 0.0, 0.0);
        }
    }
}
