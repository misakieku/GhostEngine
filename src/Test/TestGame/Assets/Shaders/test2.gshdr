shader "MyShader/Standard2" : "Unlit"
{
    properties
    {
        float customTintScale = 1.0;
    }

    hlsl
    {
        SurfaceData GetSurfaceData(in MaterialContext ctx, in MaterialProperties props, inout Payload payload)
        {
            SurfaceData surface = (SurfaceData)0;
            surface.albedo = float3(0.0, 1.0, 0.0);
            surface.emissive = float3(0.0, 0.0, 0.0);

            return surface;
        }
    }
}
