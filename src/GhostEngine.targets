<Project>
  <!-- Compute Paths Later to avoid empty $(IntermediateOutputPath) during evaluation -->
  <Target Name="ComputeGhostPaths">
    <PropertyGroup>
      <GhostIntermediateOutputPath Condition="$([System.IO.Path]::IsPathRooted('$(IntermediateOutputPath)'))">$(IntermediateOutputPath)</GhostIntermediateOutputPath>
      <GhostIntermediateOutputPath Condition="'$(GhostIntermediateOutputPath)' == ''">$(MSBuildProjectDirectory)\$(IntermediateOutputPath)</GhostIntermediateOutputPath>
      <GhostAssetDir Condition="'$(GhostAssetDir)' == ''">$(MSBuildProjectDirectory)\Asset</GhostAssetDir>
      <GhostAssetCacheDir Condition="'$(GhostAssetCacheDir)' == ''">$(GhostIntermediateOutputPath)AssetCache</GhostAssetCacheDir>
      <GhostAssetBuildDir Condition="'$(GhostAssetBuildDir)' == ''">$(TargetDir)Assets</GhostAssetBuildDir>
      <GhostShaderMetadataPath Condition="'$(GhostShaderMetadataPath)' == ''">$(GhostIntermediateOutputPath)shader_metadata.json</GhostShaderMetadataPath>
    </PropertyGroup>
  </Target>

  <!-- Hook Shader Metadata Extraction Tool -->
  <Target Name="GenerateShaderMetadata" 
          DependsOnTargets="ComputeGhostPaths"
          BeforeTargets="CoreCompile"
          Inputs="@(Compile)" 
          Outputs="$(GhostShaderMetadataPath)">
    
    <Message Importance="High" Text="Extracting Shader Metadata..." />
    
    <WriteLinesToFile File="$(GhostIntermediateOutputPath)compile_files.txt" Lines="@(Compile)" Overwrite="true" />
    
    <!-- We use dotnet run so it automatically builds the tool if needed in local dev -->
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)Tools/Ghost.ShaderMetadataTool/Ghost.ShaderMetadataTool.csproj&quot; --no-launch-profile -c Release -- &quot;$(GhostIntermediateOutputPath)compile_files.txt&quot; &quot;$(GhostShaderMetadataPath)&quot;" />
  </Target>

  <!-- Allow other projects to query this project's shader metadata path -->
  <Target Name="GetGhostShaderMetadataPath" Returns="$(GhostShaderMetadataPath)" DependsOnTargets="ComputeGhostPaths" />

  <!-- Hook Asset Forge CLI (We'll implement this in the next task) -->
  <Target Name="BakeAndPackAssets" 
          DependsOnTargets="ComputeGhostPaths"
          AfterTargets="Build"
          Condition="'$(IsGameProject)' == 'true'"
          Inputs="$(GhostAssetDir)\**\*.*"
          Outputs="$(GhostAssetBuildDir)\manifest.json">
          
    <Message Importance="High" Text="Baking and Packing Assets..." />
    
    <!-- Ask all referenced projects for their metadata files -->
    <MSBuild Projects="@(ProjectReference)" Targets="GetGhostShaderMetadataPath" SkipNonexistentTargets="true">
      <Output TaskParameter="TargetOutputs" ItemName="AllMetadata" />
    </MSBuild>
    
    <PropertyGroup>
      <GhostEngineAssetDir>$(MSBuildThisFileDirectory)Runtime/Ghost.Engine/Assets</GhostEngineAssetDir>
    </PropertyGroup>
    
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)Tools/Ghost.AssetForge.CLI/Ghost.AssetForge.CLI.csproj&quot; --no-launch-profile -c Release -- bake --asset-dir &quot;$(GhostEngineAssetDir);$(GhostAssetDir)&quot; --cache-dir &quot;$(GhostAssetCacheDir)&quot; --build-dir &quot;$(GhostAssetBuildDir)&quot; --shader-metadata &quot;$(GhostShaderMetadataPath);@(AllMetadata)&quot;" />
  </Target>
</Project>
