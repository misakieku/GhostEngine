<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>contentFiles</ContentTargetFolders>
    <GhostAssetDir>$(MSBuildProjectDirectory)\Assets</GhostAssetDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ThirdParty\Ghost.FMOD\Ghost.FMOD.csproj" />
    <ProjectReference Include="..\Ghost.Core\Ghost.Core.csproj" />
    <ProjectReference Include="..\Ghost.Entities\Ghost.Entities.csproj" />
    <ProjectReference Include="..\Ghost.Graphics\Ghost.Graphics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Misaki.HighPerformance.Analyzer" Version="1.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ppy.SDL3-CS" Version="2026.1002.1" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="**\*.cs" Exclude="obj\**;bin\**">
      <Pack>true</Pack>
      <PackagePath>contentFiles\cs\net10.0\Ghost.Engine\</PackagePath>
      <PackageCopyToOutput>false</PackageCopyToOutput>
      <BuildAction>Compile</BuildAction>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\Ghost.Generator\Ghost.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="..\..\GhostEngine.targets" />
</Project>
