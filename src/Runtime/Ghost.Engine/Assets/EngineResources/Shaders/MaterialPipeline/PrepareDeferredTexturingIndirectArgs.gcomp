compute "Internal/PrepareDeferredTexturingIndirectArgs"
{
    properties
    {
        uint counterBuffer;
        uint indirectArgsBuffer;
        uint binOffsetsBuffer;
        uint binScatterCounters;
        uint maxVariants;
    }

    includes
    {
        "EngineResources/Shaders/Properties.hlsl";
        "EngineResources/Shaders/MaterialPipeline/ClassificationCommon.hlsl";
    }

    hlsl
    {
        #define SCAN_THREADS 256

        groupshared uint s_scan[SCAN_THREADS];

        [numthreads(SCAN_THREADS, 1, 1)]
        void CSMain(uint3 dispatchThreadId : SV_DispatchThreadID)
        {
            InternalPrepareDeferredTexturingIndirectArgsShaderProperties props = LoadData<InternalPrepareDeferredTexturingIndirectArgsShaderProperties>(g_PushConstantData.userData0, 0);

            RWByteAddressBuffer counterBuffer = ResourceDescriptorHeap[props.counterBuffer];
            RWByteAddressBuffer indirectArgsBuffer = ResourceDescriptorHeap[props.indirectArgsBuffer];
            RWByteAddressBuffer binOffsets = ResourceDescriptorHeap[props.binOffsetsBuffer];
            RWByteAddressBuffer binCounters = ResourceDescriptorHeap[props.binScatterCounters];

            uint v = dispatchThreadId.x;
            uint count = 0;
            if (v < props.maxVariants)
            {
                count = counterBuffer.Load(CLASSIFICATION_OFFSET_VARIANT_COUNTS + v * 4u);
            }

            s_scan[v] = count;
            GroupMemoryBarrierWithGroupSync();

            // Parallel inclusive prefix sum (Hillis-Steele algorithm)
            [unroll]
            for (uint stride = 1; stride < SCAN_THREADS; stride <<= 1)
            {
                uint temp = 0;
                if (v >= stride)
                {
                    temp = s_scan[v - stride];
                }
                GroupMemoryBarrierWithGroupSync();
                s_scan[v] += temp;
                GroupMemoryBarrierWithGroupSync();
            }

            // Convert inclusive scan to exclusive prefix sum
            uint exclusiveOffset = (v > 0) ? s_scan[v - 1] : 0;

            if (v < props.maxVariants)
            {
                binOffsets.Store(v * 4u, exclusiveOffset);
                binCounters.Store(v * 4u, exclusiveOffset);

                // D3D12_DISPATCH_ARGUMENTS: ThreadGroupCountX, ThreadGroupCountY, ThreadGroupCountZ, padding
                indirectArgsBuffer.Store4(v * INDIRECT_ARGS_STRIDE, uint4(count, 1u, 1u, 0u));
            }
        }
    }

    cs "hlsl_block" : "CSMain";
}
