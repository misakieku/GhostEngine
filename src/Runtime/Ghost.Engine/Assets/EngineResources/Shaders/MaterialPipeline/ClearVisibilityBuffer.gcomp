compute "Internal/ClearVisibilityBuffer"
{
    properties
    {
        uint visBufferIndex;
        uint renderWidth;
        uint renderHeight;
    }

    includes
    {
        "EngineResources/Shaders/Properties.hlsl";
    }

    hlsl
    {
        [numthreads(16, 16, 1)]
        void CSMain(uint3 dispatchThreadId : SV_DispatchThreadID)
        {

            if (dispatchThreadId.x >= g_Properties.renderWidth || dispatchThreadId.y >= g_Properties.renderHeight)
            {
                return;
            }

            RWTexture2D<uint2> visBuffer = GET_TEXTURE2D(g_Properties.visBufferIndex);
            visBuffer[dispatchThreadId.xy] = uint2(0, 0);
        }
    }

    cs "hlsl_block" : "CSMain";
}
