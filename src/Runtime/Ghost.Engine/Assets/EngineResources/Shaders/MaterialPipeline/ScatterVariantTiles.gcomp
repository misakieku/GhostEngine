compute "Internal/ScatterVariantTiles"
{
    properties
    {
        uint unbinnedTilesBuffer;
        uint binnedTileListBuffer;
        uint binScatterCounters;
        uint counterBuffer;
        uint maxTileEntries;
    }

    includes
    {
        "EngineResources/Shaders/Properties.hlsl";
        "EngineResources/Shaders/MaterialPipeline/ClassificationCommon.hlsl";
    }

    hlsl
    {
        [numthreads(64, 1, 1)]
        void CSMain(uint3 dispatchThreadId : SV_DispatchThreadID)
        {

            RWByteAddressBuffer counterBuf = GET_BUFFER(g_Properties.counterBuffer);
            uint totalEntries = counterBuf.Load(CLASSIFICATION_OFFSET_TOTAL_ENTRIES);
            if (totalEntries > g_Properties.maxTileEntries)
            {
                totalEntries = g_Properties.maxTileEntries;
            }

            uint slotIndex = dispatchThreadId.x;
            if (slotIndex >= totalEntries)
            {
                return;
            }

            ByteAddressBuffer unbinned = GET_BUFFER(g_Properties.unbinnedTilesBuffer);
            uint2 entry = unbinned.Load2(slotIndex * 8u);
            uint tileIndex = entry.x;
            uint variantIndex = entry.y;

            RWByteAddressBuffer scatterCounters = GET_BUFFER(g_Properties.binScatterCounters);
            uint dstSlot;
            scatterCounters.InterlockedAdd(variantIndex * 4u, 1u, dstSlot);

            if (dstSlot < g_Properties.maxTileEntries)
            {
                RWByteAddressBuffer binned = GET_BUFFER(g_Properties.binnedTileListBuffer);
                binned.Store(dstSlot * 4u, tileIndex);
            }
        }
    }

    cs "hlsl_block" : "CSMain";
}
