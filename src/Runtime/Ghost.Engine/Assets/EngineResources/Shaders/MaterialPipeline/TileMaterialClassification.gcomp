compute "Internal/TileMaterialClassification"
{
    properties
    {
        uint4 deferredVariantMask0;
        uint4 deferredVariantMask1;
        uint visBufferIndex;
        uint visibleMeshletsPass1;
        uint visibleMeshletsPass2;
        uint counterBufferUav;
        uint unbinnedTilesUav;
        uint tileShadingModelMaskBufferUav;
        uint variantShadingModelsTableBufferIndex;
        uint renderWidth;
        uint renderHeight;
        uint tilesPerRow;
        uint maxUnbinnedEntries;
    }

    includes
    {
        "EngineResources/Shaders/Properties.hlsl";
        "EngineResources/Shaders/Mesh.hlsl";
        "EngineResources/Shaders/Utilities/CullCommon.hlsl";
        "EngineResources/Shaders/MaterialPipeline/MaterialEncoding.hlsl";
        "EngineResources/Shaders/MaterialPipeline/VisibilityBufferEncoding.hlsl";
        "EngineResources/Shaders/MaterialPipeline/ClassificationCommon.hlsl";
    }

    hlsl
    {
        groupshared uint s_tileVariantMask[8];
        groupshared uint s_tileEntryCount;
        groupshared uint s_tileEntryBase;
        groupshared uint s_tileShadingModelMask;

        [numthreads(CLASSIFICATION_TILE_SIZE, CLASSIFICATION_TILE_SIZE, 1)]
        void CSMain(
            uint3 dispatchThreadId : SV_DispatchThreadID,
            uint3 groupID : SV_GroupID,
            uint3 groupThreadId : SV_GroupThreadID,
            uint groupIndex : SV_GroupIndex)
        {
            InternalTileMaterialClassificationShaderProperties props = LoadData<InternalTileMaterialClassificationShaderProperties>(g_PushConstantData.userData0, 0);

            if (groupIndex < 8u)
            {
                s_tileVariantMask[groupIndex] = 0u;
            }
            if (groupIndex == 0u)
            {
                s_tileEntryCount = 0u;
                s_tileEntryBase = 0u;
                s_tileShadingModelMask = 0u;
            }
            GroupMemoryBarrierWithGroupSync();

            uint2 pixelCoord = groupID.xy * CLASSIFICATION_TILE_SIZE + groupThreadId.xy;
            uint tileIndex = EncodeTileIndex(groupID.xy, props.tilesPerRow);

            bool isValid = false;
            uint variantIndex = 0xFFFFFFFFu;

            if (pixelCoord.x < props.renderWidth && pixelCoord.y < props.renderHeight)
            {
                Texture2D<uint2> visBuffer = GET_TEXTURE2D(props.visBufferIndex);
                uint2 raw = visBuffer[pixelCoord];

                float depth;
                uint visibleMeshletIndex;
                uint primitiveID;
                UnpackVisibility2(raw, depth, visibleMeshletIndex, primitiveID);

                // Reversed-Z: depth > 0.0f indicates valid geometry
                if (depth > 0.0f)
                {
                    uint passBit = (visibleMeshletIndex >> 23u) & 1u;
                    uint rawMeshletIndex = visibleMeshletIndex & 0x7FFFFFu;

                    uint visibleBufferIndex = (passBit == 0u) ? props.visibleMeshletsPass1 : props.visibleMeshletsPass2;
                    StructuredBuffer<VisibleMeshletEntry> visibleMeshlets = GET_BUFFER(visibleBufferIndex);
                    VisibleMeshletEntry visible = visibleMeshlets[rawMeshletIndex];

                    InstanceData instanceData = LoadData<InstanceData>(g_FrameData.sceneBuffer, visible.instanceIndex);
                    MeshData meshData = LoadData<MeshData>(instanceData.meshBuffer, 0);

                    Meshlet meshlet = LoadMeshlet(visible.meshletIndex, meshData);
                    uint localMaterialIndex = (meshlet.packedCounts >> 16u) & 0xFFu;

                    uint packedMaterial = LoadMaterialBindlessIndex(
                        g_FrameData.paletteOffsetBuffer,
                        g_FrameData.materialIndexBuffer,
                        instanceData.materialPaletteIndex,
                        localMaterialIndex);

                    uint candidateVariant = UnpackMaterialVariantIndex(packedMaterial);

                    if (candidateVariant < MAX_CLASSIFICATION_VARIANTS &&
                        IsDeferredVariant(candidateVariant, props.deferredVariantMask0, props.deferredVariantMask1))
                    {
                        variantIndex = candidateVariant;
                        isValid = true;
                    }
                }
            }

            if (isValid)
            {
                InterlockedOr(s_tileVariantMask[variantIndex >> 5u], 1u << (variantIndex & 31u));
            }
            GroupMemoryBarrierWithGroupSync();

            // Thread v (groupIndex 0..255) checks if variant v is present in this tile
            uint v = groupIndex;
            bool isPresent = false;
            if (v < MAX_CLASSIFICATION_VARIANTS)
            {
                isPresent = (s_tileVariantMask[v >> 5u] & (1u << (v & 31u))) != 0u;
            }

            uint localSlot = 0u;
            if (isPresent)
            {
                InterlockedAdd(s_tileEntryCount, 1u, localSlot);

                if (IS_VALID_BUFFER(props.variantShadingModelsTableBufferIndex))
                {
                    ByteAddressBuffer variantShadingModels = GET_BUFFER(props.variantShadingModelsTableBufferIndex);
                    uint shadingModel = variantShadingModels.Load(v * 4u);
                    if (shadingModel < 32u)
                    {
                        InterlockedOr(s_tileShadingModelMask, 1u << shadingModel);
                    }
                }
            }
            GroupMemoryBarrierWithGroupSync();

            // Thread 0 allocates unbinned slots for this tile in the global counter buffer
            if (groupIndex == 0u && s_tileEntryCount > 0u)
            {
                RWByteAddressBuffer counters = GET_BUFFER(props.counterBufferUav);
                counters.InterlockedAdd(CLASSIFICATION_OFFSET_TOTAL_ENTRIES, s_tileEntryCount, s_tileEntryBase);
            }
            GroupMemoryBarrierWithGroupSync();

            // Each present variant writes its unbinned entry and tallies its variant count
            if (isPresent)
            {
                RWByteAddressBuffer counters = GET_BUFFER(props.counterBufferUav);
                counters.InterlockedAdd(CLASSIFICATION_OFFSET_VARIANT_COUNTS + v * 4u, 1u);

                uint unbinnedSlot = s_tileEntryBase + localSlot;
                if (unbinnedSlot < props.maxUnbinnedEntries)
                {
                    RWByteAddressBuffer unbinned = GET_BUFFER(props.unbinnedTilesUav);
                    unbinned.Store2(unbinnedSlot * 8u, uint2(tileIndex, v));
                }
            }

            if (groupIndex == 0u && IS_VALID_BUFFER(props.tileShadingModelMaskBufferUav))
            {
                RWByteAddressBuffer maskBuffer = GET_BUFFER(props.tileShadingModelMaskBufferUav);
                maskBuffer.Store(tileIndex * 4u, s_tileShadingModelMask);
            }
        }
    }

    cs "hlsl_block" : "CSMain";
}
