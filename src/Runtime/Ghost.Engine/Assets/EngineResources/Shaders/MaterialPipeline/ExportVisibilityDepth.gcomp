compute "Internal/ExportVisibilityDepth"
{
    properties
    {
        uint visBufferIndex;
        uint depthTextureUav;
        uint renderWidth;
        uint renderHeight;
    }

    includes
    {
        "EngineResources/Shaders/Properties.hlsl";
        "EngineResources/Shaders/MaterialPipeline/VisibilityBufferEncoding.hlsl";
    }

    hlsl
    {
        [numthreads(16, 16, 1)]
        void CSMain(uint3 dispatchThreadId : SV_DispatchThreadID)
        {
            RWTexture2D<float> depthTexture = GET_TEXTURE2D(g_Properties.depthTextureUav);

            if (dispatchThreadId.x >= g_Properties.renderWidth || dispatchThreadId.y >= g_Properties.renderHeight)
            {
                return;
            }

            Texture2D<uint2> visBuffer = GET_TEXTURE2D(g_Properties.visBufferIndex);
            float depth = asfloat(visBuffer[dispatchThreadId.xy].y);

            depthTexture[dispatchThreadId.xy] = depth;
        }
    }

    cs "hlsl_block" : "CSMain";
}
