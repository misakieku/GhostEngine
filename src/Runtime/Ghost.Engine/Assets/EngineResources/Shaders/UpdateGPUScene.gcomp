compute "Internal/UpdateGPUScene"
{
    includes
    {
        "EngineResources/Shaders/Includes/Properties.hlsl";
        "EngineResources/Shaders/Includes/Generated/GhostRenderPipeline.hlsl";
    }

    hlsl
    {
        [numthreads(64, 1, 1)]
        void CSMain(uint3 dispatchThreadID : SV_DispatchThreadID)
        {
            UpdateGPUSceneShaderProperty properties = LoadData<UpdateGPUSceneShaderProperty>(g_PushConstantData.propertiesBuffer, 0);
            RWStructuredBuffer<InstanceData> gpuSceneBuffer = GET_BUFFER(properties.gpuSceneBuffer);

            if (properties.updateCount > 0)
            {
                StructuredBuffer<UpdateInstanceData> updateBuffer = GET_BUFFER(properties.updateBuffer);
                UpdateInstanceData updateData = updateBuffer[dispatchThreadID.x];

                gpuSceneBuffer[updateData.instanceID].localToWorld = updateData.localToWorld;
                gpuSceneBuffer[updateData.instanceID].meshBuffer = updateData.meshBuffer;
                gpuSceneBuffer[updateData.instanceID].materialPaletteIndex = updateData.materialPaletteIndex;
            }

            if (properties.removeCount > 0)
            {
                StructuredBuffer<RemoveInstanceData> removeBuffer = GET_BUFFER(properties.removeBuffer);
                RemoveInstanceData removeData = removeBuffer[dispatchThreadID.x];

                gpuSceneBuffer[removeData.instanceID] = gpuSceneBuffer[removeData.swapWithInstanceID];
            }
        }
    }

    cs "hlsl_block" : "CSMain";
}
