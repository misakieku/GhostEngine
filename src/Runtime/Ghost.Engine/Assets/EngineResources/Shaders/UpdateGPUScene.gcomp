compute "Internal/UpdateGPUScene" 
{
    properties
    {
        uint gpuSceneBuffer;
        uint updateBuffer;
        uint updateCount;
        uint removeBuffer;
        uint removeCount;
    }

    includes
    {
        "EngineResources/Shaders/Properties.hlsl";
        "EngineResources/Shaders/Generated/GhostRenderPipeline.hlsl";
    }

    hlsl
    {
        [numthreads(64, 1, 1)]
        void CSMain(uint3 dispatchThreadID : SV_DispatchThreadID)
        {
            InternalUpdateGPUSceneShaderProperties properties = LoadData<InternalUpdateGPUSceneShaderProperties>(g_PushConstantData.userData0, 0);
            RWByteAddressBuffer gpuSceneBuffer = GET_BUFFER(properties.gpuSceneBuffer);

            if (dispatchThreadID.x < properties.updateCount)
            {
                StructuredBuffer<UpdateInstanceData> updateBuffer = GET_BUFFER(properties.updateBuffer);
                UpdateInstanceData updateData = updateBuffer[dispatchThreadID.x];

                InstanceData instance = (InstanceData)0;
                instance.localToWorld = updateData.localToWorld;
                instance.meshBuffer = updateData.meshBuffer;
                instance.materialPaletteIndex = updateData.materialPaletteIndex;

                gpuSceneBuffer.Store<InstanceData>(updateData.instanceID * sizeof(InstanceData), instance);
            }

            if (dispatchThreadID.x < properties.removeCount)
            {
                StructuredBuffer<RemoveInstanceData> removeBuffer = GET_BUFFER(properties.removeBuffer);
                RemoveInstanceData removeData = removeBuffer[dispatchThreadID.x];

                InstanceData swapInstance = gpuSceneBuffer.Load<InstanceData>(removeData.swapWithInstanceID * sizeof(InstanceData));
                gpuSceneBuffer.Store<InstanceData>(removeData.instanceID * sizeof(InstanceData), swapInstance);
            }
        }
    }

    cs "hlsl_block" : "CSMain";
}
