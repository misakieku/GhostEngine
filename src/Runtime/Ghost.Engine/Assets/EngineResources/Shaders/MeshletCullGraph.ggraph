compute "Internal/MeshletCullGraph"
{
    properties
    {
        uint hzbMipCount;
        uint hzbWidth;
        uint hzbHeight;
        uint cullPassIndex;
        uint visibleMeshletsUav;
        uint visibleMaskedMeshletsUav;
        uint occludedMeshletsUav;
        uint counterBufferUav;
        uint maxVisibleMeshlets;
        float lodErrorThreshold;
        uint instanceCount;
        uint hzbMip0;
        uint hzbMip1;
        uint hzbMip2;
        uint hzbMip3;
        uint hzbMip4;
        uint hzbMip5;
        uint hzbMip6;
        uint hzbMip7;
        uint hzbMip8;
        uint hzbMip9;
        uint hzbMip10;
        uint hzbMip11;
        uint hzbMip12;
        uint hzbMip13;
        uint hzbMip14;
        uint hzbMip15;
    }

    includes
    {
        "EngineResources/Shaders/Includes/Properties.hlsl";
        "EngineResources/Shaders/Includes/CullCommon.hlsl";
    }

    hlsl
    {
        struct HierarchyNodeRecord
        {
            uint instanceIndex;
            uint nodeIndex;
            uint meshletHierarchyBuffer;
            uint meshletGroupBuffer;
            uint meshletBuffer;
        };

        struct MeshletCandidateRecord
        {
            uint instanceIndex;
            uint meshletIndex;
            uint meshletBufferIndex;
        };

        struct VisibleMeshletEntry
        {
            uint instanceIndex;
            uint meshletIndex;
        };

        struct WorkGraphDispatchGridRecord
        {
            uint3 dispatchGrid : SV_DispatchGrid;
        };

        // Node 1: Entry point for instance-level culling in Pass 1
        [Shader("node")]
        [NodeLaunch("broadcasting")]
        [NodeIsProgramEntry]
        [NodeMaxDispatchGrid(65535, 1, 1)]
        [NumThreads(64, 1, 1)]
        void InstanceCullNode(
            DispatchNodeInputRecord<WorkGraphDispatchGridRecord> inputRecord,
            uint3 dispatchThreadId : SV_DispatchThreadID,
            [NodeId("HierarchyTraverseNode")] [MaxRecords(1)] NodeOutput<HierarchyNodeRecord> hierarchyQueue,
            [NodeId("MeshletCullNode")] [MaxRecords(64)] NodeOutput<MeshletCandidateRecord> meshletQueue)
        {
            InternalMeshletCullGraphShaderProperties props = LoadData<InternalMeshletCullGraphShaderProperties>(g_PushConstantData.propertiesBuffer, 0);

            uint instanceIndex = dispatchThreadId.x;
            if (instanceIndex >= props.instanceCount)
            {
                return;
            }

            FrameData frame = LoadData<FrameData>(g_PushConstantData.frameBuffer, 0);
            ViewData view = LoadData<ViewData>(g_PushConstantData.viewBuffer, 0);

            ByteAddressBuffer sceneBuffer = GET_BUFFER(frame.instanceBuffer);
            InstanceData instance = sceneBuffer.Load<InstanceData>(instanceIndex * sizeof(InstanceData));

            if (instance.meshBuffer == 0 || instance.meshBuffer == 0xFFFFFFFF)
            {
                return;
            }

            ByteAddressBuffer meshBuffer = GET_BUFFER(instance.meshBuffer);
            MeshData mesh = meshBuffer.Load<MeshData>(0);

            float3 worldMin, worldMax;
            TransformAABB(mesh.worldBoundsMin, mesh.worldBoundsMax, instance.localToWorld, worldMin, worldMax);

            FrustumTestResult frustumRes = FrustumCullAABB(worldMin, worldMax, view.viewProjectionMatrix);
            if (!frustumRes.isVisible)
            {
                return;
            }

            if (!frustumRes.intersectsNearPlane && props.hzbMipCount > 0)
            {
                float4 screenRect;
                float nearestDepth;
                if (ProjectAABBToScreen(worldMin, worldMax, view.viewMatrix, view.projectionMatrix, screenRect, nearestDepth))
                {
                    if (HZBOcclusionTest(screenRect, nearestDepth, props.hzbMipCount, props.hzbWidth, props.hzbHeight, g_PushConstantData.propertiesBuffer))
                    {
                        if (props.cullPassIndex == 0)
                        {
                            RWStructuredBuffer<uint> occludedBuffer = ResourceDescriptorHeap[props.occludedMeshletsUav];
                            RWByteAddressBuffer counterBuf = ResourceDescriptorHeap[props.counterBufferUav];

                            uint slot;
                            counterBuf.InterlockedAdd(4, 1, slot);
                            if (slot < props.maxVisibleMeshlets)
                            {
                                occludedBuffer[slot] = instanceIndex;
                            }
                        }
                        return;
                    }
                }
            }

            if (mesh.meshletHierarchyBuffer != 0 && mesh.lodLevelCount > 1)
            {
                float3 worldCenter = (worldMin + worldMax) * 0.5f;
                float worldRadius = length(worldMax - worldCenter);
                float scale = length(float3(instance.localToWorld[0][0], instance.localToWorld[1][0], instance.localToWorld[2][0]));

                ByteAddressBuffer hierarchyBuf = GET_BUFFER(mesh.meshletHierarchyBuffer);
                uint selectedLOD = 0;

                // Evaluate from coarsest level down to 1
                for (int lvl = (int)mesh.lodLevelCount - 1; lvl >= 1; --lvl)
                {
                    MeshletHierarchyNode prevLodRoot = hierarchyBuf.Load<MeshletHierarchyNode>((uint)(lvl - 1) * sizeof(MeshletHierarchyNode));
                    if (prevLodRoot.error < 3.4e38F && EvaluateLODDetailSufficient(
                        prevLodRoot.error * scale,
                        worldCenter,
                        worldRadius,
                        view.cameraPosition,
                        view.projectionMatrix[1][1],
                        view.screenSize.y,
                        props.lodErrorThreshold))
                    {
                        selectedLOD = (uint)lvl;
                        break;
                    }
                }

                ThreadNodeOutputRecords<HierarchyNodeRecord> outRec = hierarchyQueue.GetThreadNodeOutputRecords(1);
                outRec.Get().instanceIndex = instanceIndex;
                outRec.Get().nodeIndex = selectedLOD;
                outRec.Get().meshletHierarchyBuffer = mesh.meshletHierarchyBuffer;
                outRec.Get().meshletGroupBuffer = mesh.meshletGroupBuffer;
                outRec.Get().meshletBuffer = mesh.meshletBuffer;
                outRec.OutputComplete();
            }
            else
            {
                uint remaining = mesh.meshletCount;
                uint offset = 0;
                while (remaining > 0)
                {
                    uint chunk = min(remaining, 64u);
                    ThreadNodeOutputRecords<MeshletCandidateRecord> outGroup = meshletQueue.GetThreadNodeOutputRecords(chunk);
                    for (uint i = 0; i < chunk; ++i)
                    {
                        outGroup[i].instanceIndex = instanceIndex;
                        outGroup[i].meshletIndex = offset + i;
                        outGroup[i].meshletBufferIndex = mesh.meshletBuffer;
                    }
                    outGroup.OutputComplete();
                    offset += chunk;
                    remaining -= chunk;
                }
            }
        }

        // Node 2: Hierarchical LOD DAG traversal (broadcasting with 1 thread: satisfies D3D12 output limits while wasting zero threads)
        [Shader("node")]
        [NodeLaunch("broadcasting")]
        [NodeDispatchGrid(1, 1, 1)]
        [NumThreads(1, 1, 1)]
        [NodeMaxRecursionDepth(16)]
        void HierarchyTraverseNode(
            DispatchNodeInputRecord<HierarchyNodeRecord> inputRecord,
            [NodeId("HierarchyTraverseNode")] [MaxRecords(8)] NodeOutput<HierarchyNodeRecord> selfQueue,
            [NodeId("MeshletCullNode")] [MaxRecords(64)] NodeOutput<MeshletCandidateRecord> meshletQueue)
        {
            InternalMeshletCullGraphShaderProperties props = LoadData<InternalMeshletCullGraphShaderProperties>(g_PushConstantData.propertiesBuffer, 0);
            HierarchyNodeRecord rec = inputRecord.Get();

            FrameData frame = LoadData<FrameData>(g_PushConstantData.frameBuffer, 0);
            ViewData view = LoadData<ViewData>(g_PushConstantData.viewBuffer, 0);

            ByteAddressBuffer sceneBuffer = GET_BUFFER(frame.instanceBuffer);
            InstanceData instance = sceneBuffer.Load<InstanceData>(rec.instanceIndex * sizeof(InstanceData));

            ByteAddressBuffer hierarchyBuf = GET_BUFFER(rec.meshletHierarchyBuffer);
            MeshletHierarchyNode node = hierarchyBuf.Load<MeshletHierarchyNode>(rec.nodeIndex * sizeof(MeshletHierarchyNode));

            float3 worldCenter = mul(instance.localToWorld, float4(node.bounds.xyz, 1.0f)).xyz;
            float worldRadius = node.bounds.w;
            float3 worldMin = worldCenter - worldRadius;
            float3 worldMax = worldCenter + worldRadius;

            FrustumTestResult frustumRes = FrustumCullAABB(worldMin, worldMax, view.viewProjectionMatrix);
            if (!frustumRes.isVisible)
            {
                return;
            }

            if (!frustumRes.intersectsNearPlane && props.hzbMipCount > 0)
            {
                float4 screenRect;
                float nearestDepth;
                if (ProjectAABBToScreen(worldMin, worldMax, view.viewMatrix, view.projectionMatrix, screenRect, nearestDepth))
                {
                    if (HZBOcclusionTest(screenRect, nearestDepth, props.hzbMipCount, props.hzbWidth, props.hzbHeight, g_PushConstantData.propertiesBuffer))
                    {
                        return;
                    }
                }
            }

            if (node.childCount > 0)
            {
                uint childCount = min(node.childCount, 8u);
                ThreadNodeOutputRecords<HierarchyNodeRecord> outChildren = selfQueue.GetThreadNodeOutputRecords(childCount);
                for (uint c = 0; c < childCount; ++c)
                {
                    outChildren[c].instanceIndex = rec.instanceIndex;
                    outChildren[c].nodeIndex = node.childOffset + c;
                    outChildren[c].meshletHierarchyBuffer = rec.meshletHierarchyBuffer;
                    outChildren[c].meshletGroupBuffer = rec.meshletGroupBuffer;
                    outChildren[c].meshletBuffer = rec.meshletBuffer;
                }
                outChildren.OutputComplete();
            }
            else if (node.groupIndex >= 0)
            {
                ByteAddressBuffer groupBuf = GET_BUFFER(rec.meshletGroupBuffer);
                MeshletGroup group = groupBuf.Load<MeshletGroup>(node.groupIndex * sizeof(MeshletGroup));

                uint count = min(group.meshletCount, 64u);
                ThreadNodeOutputRecords<MeshletCandidateRecord> outGroup = meshletQueue.GetThreadNodeOutputRecords(count);
                for (uint i = 0; i < count; ++i)
                {
                    outGroup[i].instanceIndex = rec.instanceIndex;
                    outGroup[i].meshletIndex = group.meshletStartIndex + i;
                    outGroup[i].meshletBufferIndex = rec.meshletBuffer;
                }
                outGroup.OutputComplete();
            }
        }

        // Node 3: Coalesced fine cluster/meshlet culling with wave compaction (32x reduction in atomics)
        [Shader("node")]
        [NodeLaunch("coalescing")]
        [NumThreads(32, 1, 1)]
        void MeshletCullNode(
            [MaxRecords(32)] GroupNodeInputRecords<MeshletCandidateRecord> inputRecords,
            uint groupIndex : SV_GroupIndex)
        {
            InternalMeshletCullGraphShaderProperties props = LoadData<InternalMeshletCullGraphShaderProperties>(g_PushConstantData.propertiesBuffer, 0);

            uint numRecords = inputRecords.Count();
            bool isValid = (groupIndex < numRecords);
            MeshletCandidateRecord rec = (MeshletCandidateRecord)0;
            if (isValid)
            {
                rec = inputRecords.Get(groupIndex);
            }

            bool isVisible = false;
            uint renderType = 0;
            if (isValid)
            {
                FrameData frame = LoadData<FrameData>(g_PushConstantData.frameBuffer, 0);
                ViewData view = LoadData<ViewData>(g_PushConstantData.viewBuffer, 0);

                ByteAddressBuffer sceneBuffer = GET_BUFFER(frame.instanceBuffer);
                InstanceData instance = sceneBuffer.Load<InstanceData>(rec.instanceIndex * sizeof(InstanceData));

                ByteAddressBuffer meshletBuf = GET_BUFFER(rec.meshletBufferIndex);
                Meshlet meshlet = meshletBuf.Load<Meshlet>(rec.meshletIndex * sizeof(Meshlet));

                uint localMaterialIndex = (meshlet.packedCounts >> 16) & 0xFFu;
                uint packedMaterial = LoadMaterialBindlessIndex(frame.paletteOffsetBuffer, frame.materialIndexBuffer, instance.materialPaletteIndex, localMaterialIndex);
                renderType = (packedMaterial >> 24) & 0xFFu;

                float3 worldMin, worldMax;
                TransformAABB(meshlet.boundingBoxMin, meshlet.boundingBoxMax, instance.localToWorld, worldMin, worldMax);

                FrustumTestResult frustumRes = FrustumCullAABB(worldMin, worldMax, view.viewProjectionMatrix);
                if (frustumRes.isVisible)
                {
                    bool isOccluded = false;
                    if (!frustumRes.intersectsNearPlane && props.hzbMipCount > 0)
                    {
                        float4 screenRect;
                        float nearestDepth;
                        if (ProjectAABBToScreen(worldMin, worldMax, view.viewMatrix, view.projectionMatrix, screenRect, nearestDepth))
                        {
                            isOccluded = HZBOcclusionTest(screenRect, nearestDepth, props.hzbMipCount, props.hzbWidth, props.hzbHeight, g_PushConstantData.propertiesBuffer);
                        }
                    }
                    isVisible = !isOccluded;
                }
            }

            // Wave compaction for Opaque vs Masked
            bool isOpaque = isVisible && (renderType != 1);
            bool isMasked = isVisible && (renderType == 1);

            uint waveOpaqueCount = WaveActiveCountBits(isOpaque);
            uint localOpaqueOffset = WavePrefixCountBits(isOpaque);

            uint waveMaskedCount = WaveActiveCountBits(isMasked);
            uint localMaskedOffset = WavePrefixCountBits(isMasked);

            RWByteAddressBuffer counterBuf = ResourceDescriptorHeap[props.counterBufferUav];
            uint opaqueCounterOffset = (props.cullPassIndex == 0) ? 0 : 8;
            uint maskedCounterOffset = (props.cullPassIndex == 0) ? 12 : 16;

            uint waveOpaqueBase = 0;
            if (WaveIsFirstLane() && waveOpaqueCount > 0)
            {
                counterBuf.InterlockedAdd(opaqueCounterOffset, waveOpaqueCount, waveOpaqueBase);
            }
            waveOpaqueBase = WaveReadLaneFirst(waveOpaqueBase);

            uint waveMaskedBase = 0;
            if (WaveIsFirstLane() && waveMaskedCount > 0)
            {
                counterBuf.InterlockedAdd(maskedCounterOffset, waveMaskedCount, waveMaskedBase);
            }
            waveMaskedBase = WaveReadLaneFirst(waveMaskedBase);

            if (isOpaque)
            {
                uint slot = waveOpaqueBase + localOpaqueOffset;
                if (slot < props.maxVisibleMeshlets)
                {
                    RWStructuredBuffer<VisibleMeshletEntry> visibleBuffer = ResourceDescriptorHeap[props.visibleMeshletsUav];
                    VisibleMeshletEntry entry;
                    entry.instanceIndex = rec.instanceIndex;
                    entry.meshletIndex = rec.meshletIndex;
                    visibleBuffer[slot] = entry;
                }
            }
            else if (isMasked)
            {
                uint slot = waveMaskedBase + localMaskedOffset;
                if (slot < props.maxVisibleMeshlets)
                {
                    RWStructuredBuffer<VisibleMeshletEntry> maskedBuffer = ResourceDescriptorHeap[props.visibleMaskedMeshletsUav];
                    VisibleMeshletEntry entry;
                    entry.instanceIndex = rec.instanceIndex;
                    entry.meshletIndex = rec.meshletIndex;
                    maskedBuffer[slot] = entry;
                }
            }
        }

        // Node 4: Pass 2 late culling for previously occluded instances against current HZB with correct LOD selection
        [Shader("node")]
        [NodeLaunch("broadcasting")]
        [NodeIsProgramEntry]
        [NodeMaxDispatchGrid(65535, 1, 1)]
        [NumThreads(64, 1, 1)]
        void OccludedInstanceCullNode(
            DispatchNodeInputRecord<WorkGraphDispatchGridRecord> inputRecord,
            uint3 dispatchThreadId : SV_DispatchThreadID,
            [NodeId("HierarchyTraverseNode")] [MaxRecords(1)] NodeOutput<HierarchyNodeRecord> hierarchyQueue,
            [NodeId("MeshletCullNode")] [MaxRecords(64)] NodeOutput<MeshletCandidateRecord> meshletQueue)
        {
            InternalMeshletCullGraphShaderProperties props = LoadData<InternalMeshletCullGraphShaderProperties>(g_PushConstantData.propertiesBuffer, 0);

            RWByteAddressBuffer counterBuf = ResourceDescriptorHeap[props.counterBufferUav];
            uint occludedCount = counterBuf.Load(4);

            uint slotIndex = dispatchThreadId.x;
            if (slotIndex >= occludedCount)
            {
                return;
            }

            StructuredBuffer<uint> occludedBuffer = ResourceDescriptorHeap[props.occludedMeshletsUav];
            uint instanceIndex = occludedBuffer[slotIndex];

            FrameData frame = LoadData<FrameData>(g_PushConstantData.frameBuffer, 0);
            ViewData view = LoadData<ViewData>(g_PushConstantData.viewBuffer, 0);

            ByteAddressBuffer sceneBuffer = GET_BUFFER(frame.instanceBuffer);
            InstanceData instance = sceneBuffer.Load<InstanceData>(instanceIndex * sizeof(InstanceData));

            if (instance.meshBuffer == 0 || instance.meshBuffer == 0xFFFFFFFF)
            {
                return;
            }

            ByteAddressBuffer meshBuffer = GET_BUFFER(instance.meshBuffer);
            MeshData mesh = meshBuffer.Load<MeshData>(0);

            float3 worldMin, worldMax;
            TransformAABB(mesh.worldBoundsMin, mesh.worldBoundsMax, instance.localToWorld, worldMin, worldMax);

            FrustumTestResult frustumRes = FrustumCullAABB(worldMin, worldMax, view.viewProjectionMatrix);
            if (!frustumRes.isVisible)
            {
                return;
            }

            if (!frustumRes.intersectsNearPlane && props.hzbMipCount > 0)
            {
                float4 screenRect;
                float nearestDepth;
                if (ProjectAABBToScreen(worldMin, worldMax, view.viewMatrix, view.projectionMatrix, screenRect, nearestDepth))
                {
                    if (HZBOcclusionTest(screenRect, nearestDepth, props.hzbMipCount, props.hzbWidth, props.hzbHeight, g_PushConstantData.propertiesBuffer))
                    {
                        // Still occluded in Pass 2
                        return;
                    }
                }
            }

            // Instance is now visible in Pass 2! Run normal LOD selection:
            if (mesh.meshletHierarchyBuffer != 0 && mesh.lodLevelCount > 1)
            {
                float3 worldCenter = (worldMin + worldMax) * 0.5f;
                float worldRadius = length(worldMax - worldCenter);
                float scale = length(float3(instance.localToWorld[0][0], instance.localToWorld[1][0], instance.localToWorld[2][0]));

                ByteAddressBuffer hierarchyBuf = GET_BUFFER(mesh.meshletHierarchyBuffer);
                uint selectedLOD = 0;

                for (int lvl = (int)mesh.lodLevelCount - 1; lvl >= 1; --lvl)
                {
                    MeshletHierarchyNode prevLodRoot = hierarchyBuf.Load<MeshletHierarchyNode>((uint)(lvl - 1) * sizeof(MeshletHierarchyNode));
                    if (prevLodRoot.error < 3.4e38F && EvaluateLODDetailSufficient(
                        prevLodRoot.error * scale,
                        worldCenter,
                        worldRadius,
                        view.cameraPosition,
                        view.projectionMatrix[1][1],
                        view.screenSize.y,
                        props.lodErrorThreshold))
                    {
                        selectedLOD = (uint)lvl;
                        break;
                    }
                }

                ThreadNodeOutputRecords<HierarchyNodeRecord> outRec = hierarchyQueue.GetThreadNodeOutputRecords(1);
                outRec.Get().instanceIndex = instanceIndex;
                outRec.Get().nodeIndex = selectedLOD;
                outRec.Get().meshletHierarchyBuffer = mesh.meshletHierarchyBuffer;
                outRec.Get().meshletGroupBuffer = mesh.meshletGroupBuffer;
                outRec.Get().meshletBuffer = mesh.meshletBuffer;
                outRec.OutputComplete();
            }
            else
            {
                uint remaining = mesh.meshletCount;
                uint offset = 0;
                while (remaining > 0)
                {
                    uint chunk = min(remaining, 64u);
                    ThreadNodeOutputRecords<MeshletCandidateRecord> outGroup = meshletQueue.GetThreadNodeOutputRecords(chunk);
                    for (uint i = 0; i < chunk; ++i)
                    {
                        outGroup[i].instanceIndex = instanceIndex;
                        outGroup[i].meshletIndex = offset + i;
                        outGroup[i].meshletBufferIndex = mesh.meshletBuffer;
                    }
                    outGroup.OutputComplete();
                    offset += chunk;
                    remaining -= chunk;
                }
            }
        }
    }

    cs "hlsl_block" : "CSMain";
}
