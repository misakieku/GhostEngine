compute "Internal/MeshletCullGraph"
{
    properties
    {
        uint hzbMipCount;
        uint renderWidth;
        uint renderHeight;
        uint cullPassIndex;
        uint visibleMeshletsUav;
        uint occludedMeshletsUav;
        uint counterBufferUav;
        uint maxVisibleMeshlets;
        float lodErrorThreshold;
        float cullingThreshold;
        uint instanceCount;
        uint hzbTexture;
        uint hzbBaseWidth;
        uint hzbBaseHeight;
        uint cullPassSemantic;
    }

    includes
    {
        "EngineResources/Shaders/Includes/Properties.hlsl";
        "EngineResources/Shaders/Includes/CullCommon.hlsl";
        "EngineResources/Shaders/Includes/MaterialEncoding.hlsl";
    }

    hlsl
    {
        struct HierarchyNodeRecord
        {
            uint instanceIndex;
            uint nodeIndex;
        };

        struct MeshletGroupRecord
        {
            uint instanceIndex;
            uint meshletStartIndex;
            uint meshletCount;
            uint meshletBuffer;
        };

        struct WorkGraphDispatchGridRecord
        {
            uint3 dispatchGrid : SV_DispatchGrid;
        };

        static inline bool TestHZB(float4 clipMin, float4 clipMax, InternalMeshletCullGraphShaderProperties props)
        {
            return HZBVisible(
                clipMin,
                clipMax,
                props.hzbMipCount,
                props.renderWidth,
                props.renderHeight,
                props.hzbTexture,
                props.hzbBaseWidth,
                props.hzbBaseHeight);
        }

        // Node 1: Entry point for instance-level culling in Pass 1
        [Shader("node")]
        [NodeLaunch("broadcasting")]
        [NodeIsProgramEntry]
        [NodeMaxDispatchGrid(65535, 1, 1)]
        [NumThreads(64, 1, 1)]
        void InstanceCullNode(
            DispatchNodeInputRecord<WorkGraphDispatchGridRecord> inputRecord,
            uint3 dispatchThreadId : SV_DispatchThreadID,
            [NodeId("HierarchyTraverseNode")] [MaxRecords(64)] NodeOutput<HierarchyNodeRecord> hierarchyQueue)
        {
            InternalMeshletCullGraphShaderProperties props = LoadData<InternalMeshletCullGraphShaderProperties>(g_PushConstantData.userData0, 0);

            uint instanceIndex = dispatchThreadId.x;

            bool isVisible = false;
            if (instanceIndex < props.instanceCount)
            {
                InstanceData instance = LoadData<InstanceData>(g_FrameData.sceneBuffer, instanceIndex);

                if (instance.meshBuffer != INVALID_BUFFER_INDEX)
                {
                    MeshData mesh = LoadData<MeshData>(instance.meshBuffer, 0);

                    float3 worldMin, worldMax;
                    TransformAABB(mesh.worldBoundsMin, mesh.worldBoundsMax, instance.localToWorld, worldMin, worldMax);

                    isVisible = AABBIntersectFrustum(worldMin, worldMax, g_ViewData.frustum.planes);
                }
            }

            // Output record handles are group-uniform: both the allocation call and OutputComplete()
            // must be reached by every thread in the group. The early-out is therefore carried by the
            // per-thread record *count* rather than by control flow.
            ThreadNodeOutputRecords<HierarchyNodeRecord> outRec =
            hierarchyQueue.GetThreadNodeOutputRecords(isVisible ? 1u : 0u);

            if (isVisible)
            {
                outRec.Get().instanceIndex = instanceIndex;
                outRec.Get().nodeIndex = 0;
            }

            outRec.OutputComplete();
        }

        // Node 2: Hierarchical LOD DAG traversal
        [Shader("node")]
        [NodeLaunch("thread")]
        [NodeMaxRecursionDepth(16)]
        void HierarchyTraverseNode(
            ThreadNodeInputRecord<HierarchyNodeRecord> inputRecord,
            [NodeId("HierarchyTraverseNode")] [MaxRecords(7)] NodeOutput<HierarchyNodeRecord> selfQueue,
            [NodeId("MeshletCullNode")]       [MaxRecords(1)] NodeOutput<MeshletGroupRecord> groupQueue)
        {
            InternalMeshletCullGraphShaderProperties props = LoadData<InternalMeshletCullGraphShaderProperties>(g_PushConstantData.userData0, 0);
            HierarchyNodeRecord rec = inputRecord.Get();

            InstanceData instance = LoadData<InstanceData>(g_FrameData.sceneBuffer, rec.instanceIndex);
            MeshData mesh = LoadData<MeshData>(instance.meshBuffer, 0);
            MeshletHierarchyNode node = LoadData<MeshletHierarchyNode>(mesh.meshletHierarchyBuffer, rec.nodeIndex);

            // 1. Frustum culling with bounding sphere
            float3 scale3 = float3(
                length(instance.localToWorld._m00_m10_m20),
                length(instance.localToWorld._m01_m11_m21),
                length(instance.localToWorld._m02_m12_m22));
            float maxScale = max(scale3.x, max(scale3.y, scale3.z));

            float3 worldCenter = mul(instance.localToWorld, float4(node.bounds.xyz, 1.0f)).xyz;
            float worldRadius = node.bounds.w * maxScale;
            
            float z_view = dot(worldCenter - g_ViewData.cameraPosition, g_ViewData.cameraDirection);
            float r_percentage = (worldRadius * g_ViewData.projectionMatrix[1][1] * 100.0f) / (2.0f * z_view );

            if (!SphereIntersectFrustum(worldCenter, worldRadius, g_ViewData.frustum.planes))
            {
                return;
            }

            // 2. Dual-Error Parent Error Pruning:
            // If the parent (coarser LOD) error already satisfies the screen-space threshold,
            // the coarser representation is sufficient and this subtree can be pruned.
            bool isParentDetailSufficient = (node.error < 3.4e38f) && EvaluateLODDetailSufficient(
                node.error * maxScale,
                worldCenter,
                worldRadius,
                g_ViewData.cameraPosition,
                g_ViewData.projectionMatrix[1][1],
                g_ViewData.screenSize.y,
                props.lodErrorThreshold);

            if (isParentDetailSufficient)
            {
                return; // Prune branch: coarser LOD is sufficient
            }

            if (node.groupIndex < 0)
            {
                // Internal node: traverse into children
                uint childCount = min(node.childCount, 7u);
                if (childCount > 0)
                {
                    ThreadNodeOutputRecords<HierarchyNodeRecord> outChildren = selfQueue.GetThreadNodeOutputRecords(childCount);
                    for (uint c = 0;c < childCount;++c)
                    {
                        outChildren[c].instanceIndex = rec.instanceIndex;
                        outChildren[c].nodeIndex = node.childOffset + c;
                    }
                    outChildren.OutputComplete();
                }
            }
            else
            {
                if (node.groupIndex >= 0)
                {
                    // Emit the group straight to the cull node. One record launches ceil(count / 32)
                    // thread groups (see the cull node's consumer logic). This replaces the former
                    // broadcasting "ExpandGroupNode" amplifier, which existed only because a
                    // thread-launch node cannot emit more than 8 records / 128 bytes, and whose
                    // group-wide OutputComplete cost one device-scope publish per meshlet group.
                    MeshletGroup group = LoadData<MeshletGroup>(mesh.meshletGroupBuffer, (uint) node.groupIndex);

                    ThreadNodeOutputRecords<MeshletGroupRecord> outGroup = groupQueue.GetThreadNodeOutputRecords(1);
                    outGroup.Get().instanceIndex = rec.instanceIndex;
                    outGroup.Get().meshletStartIndex = group.meshletStartIndex;
                    outGroup.Get().meshletCount = group.meshletCount;
                    outGroup.Get().meshletBuffer = mesh.meshletBuffer;
                    outGroup.OutputComplete();
                }
            }
        }

        // Node 3: Fine cluster/meshlet culling with wave compaction (32x reduction in atomics).
        // Coalesces multiple MeshletGroupRecords into 128-thread groups (4 warps / records).
        // Each 32-lane wave independently processes one group of up to 32 meshlets, ensuring full
        // wave convergence, uniform instance loads per wave, and eliminating the independent
        // single-warp grid dispatch bottleneck that restricted active warps to 22-24 on hardware.
        [Shader("node")]
        [NodeLaunch("coalescing")]
        [NumThreads(128, 1, 1)]
        [WaveSize(32)]
        void MeshletCullNode(
            [MaxRecords(4)] GroupNodeInputRecords<MeshletGroupRecord> inputRecords,
            uint groupThreadId : SV_GroupThreadID)
        {
            uint recordIndex = groupThreadId / 32;
            uint laneIndex = groupThreadId % 32;

            if (recordIndex >= inputRecords.Count())
            {
                return;
            }

            MeshletGroupRecord groupRec = inputRecords.Get(recordIndex);

            uint meshletIndex = groupRec.meshletStartIndex + laneIndex;

            bool isValid = (laneIndex < groupRec.meshletCount);
            MeshletCandidateRecord rec = (MeshletCandidateRecord) 0;

            rec.instanceIndex = groupRec.instanceIndex;
            rec.meshletIndex = meshletIndex;
            rec.meshletBufferIndex = groupRec.meshletBuffer;

            // Keeping the loads below wave-uniform costs one redundant load for inactive lanes; the
            // results are discarded by the isValid guards. meshletIndex is always an in-range meshlet
            // index for this mesh, so the redundant load is well defined.
            uint safeMeshletIndex = isValid ? meshletIndex : groupRec.meshletStartIndex;

            InstanceData instanceData = LoadData<InstanceData>(g_FrameData.sceneBuffer, rec.instanceIndex);
            Meshlet meshlet = LoadData<Meshlet>(rec.meshletBufferIndex, safeMeshletIndex);

            float maxScale = 1.0f;
            if (WaveIsFirstLane())
            {
                float3 scale3 = float3(
                    length(instanceData.localToWorld._m00_m10_m20),
                    length(instanceData.localToWorld._m01_m11_m21),
                    length(instanceData.localToWorld._m02_m12_m22));
                maxScale = max(scale3.x, max(scale3.y, scale3.z));
            }
            maxScale = WaveReadLaneFirst(maxScale);

            bool isVisible = false;
            uint renderType = 0;
            bool inFrustum = false;
            bool isOccluded = false;

            InternalMeshletCullGraphShaderProperties props = LoadData<InternalMeshletCullGraphShaderProperties>(g_PushConstantData.userData0, 0);

            if (isValid)
            {
                float3 meshletWorldCenter = mul(instanceData.localToWorld, float4(meshlet.boundingSphere.xyz, 1.0f)).xyz;
                float meshletWorldRadius = meshlet.boundingSphere.w * maxScale;

                float3 meshletParentWorldCenter = mul(instanceData.localToWorld, float4(meshlet.parentBoundingSphere.xyz, 1.0f)).xyz;
                float meshletParentWorldRadius = meshlet.parentBoundingSphere.w * maxScale;

                // Dual-Error Cut Condition 1: Parent Error check (Lower bound)
                // If parent (coarser LOD) is already accurate enough, this fine meshlet must NOT render!
                bool isParentDetailSufficient = (meshlet.parentError < 3.4e38f) && EvaluateLODDetailSufficient(
                    meshlet.parentError * maxScale,
                    meshletParentWorldCenter,
                    meshletParentWorldRadius,
                    g_ViewData.cameraPosition,
                    g_ViewData.projectionMatrix[1][1],
                    g_ViewData.screenSize.y,
                    props.lodErrorThreshold);

                // Dual-Error Cut Condition 2: Cluster Error test (Upper bound)
                // Discard meshlets that are too coarse; their error exceeds the threshold,
                // so a finer LOD level must render instead.
                bool isClusterDetailSufficient = (meshlet.clusterError <= 0.0f) || EvaluateLODDetailSufficient(
                    meshlet.clusterError * maxScale,
                    meshletWorldCenter,
                    meshletWorldRadius,
                    g_ViewData.cameraPosition,
                    g_ViewData.projectionMatrix[1][1],
                    g_ViewData.screenSize.y,
                    props.lodErrorThreshold);

                if (isParentDetailSufficient || !isClusterDetailSufficient)
                {
                    isValid = false;
                }
                else
                {
                    uint localMaterialIndex = (meshlet.packedCounts >> 16) & 0xFFu;
                    uint packedMaterial = LoadMaterialBindlessIndex(g_FrameData.paletteOffsetBuffer, g_FrameData.materialIndexBuffer, instanceData.materialPaletteIndex, localMaterialIndex);
                    uint variantIndex = UnpackMaterialVariantIndex(packedMaterial);

                    if (g_FrameData.userBuffer != INVALID_BUFFER_INDEX)
                    {
                        ByteAddressBuffer metaBuf = GET_BUFFER(g_FrameData.userBuffer);
                        uint supportedPasses = metaBuf.Load(variantIndex * 4);
                        if ((supportedPasses & (1u << props.cullPassSemantic)) == 0)
                        {
                            isValid = false;
                        }
                    }

                    if (isValid)
                    {
                        BBoxFrustumResult cullResult = BBoxIntersectFrustum<false>(meshlet.boundingBoxMin, meshlet.boundingBoxMax, instanceData.localToWorld);
                        inFrustum = cullResult.isVisible;
                        if (WaveActiveAnyTrue(inFrustum))
                        {
                            if (inFrustum && props.hzbMipCount > 0)
                            {
                                if (props.cullPassIndex == 0)
                                {
                                    BBoxFrustumResult prevCullResult = BBoxIntersectFrustum<true>(meshlet.boundingBoxMin, meshlet.boundingBoxMax, instanceData.localToWorld);
                                    if (prevCullResult.isVisible && prevCullResult.clipValid)
                                    {
                                        isOccluded = !TestHZB(prevCullResult.clipMin, prevCullResult.clipMax, props);
                                    }
                                }
                                else if (cullResult.clipValid)
                                {
                                    isOccluded = !TestHZB(cullResult.clipMin, cullResult.clipMax, props);
                                }
                            }

                            isVisible = !isOccluded;
                        }
                    }
                }
            }

            // Wave compaction for visible meshlets
            uint waveVisibleCount = WaveActiveCountBits(isVisible);
            uint localVisibleOffset = WavePrefixCountBits(isVisible);

            // In Pass 1: queue occluded meshlets to be re-evaluated in Pass 2 against current HZB
            bool isOccludedCandidate = (props.cullPassIndex == 0) && isValid && inFrustum && isOccluded;
            uint waveOccCount = WaveActiveCountBits(isOccludedCandidate);
            uint localOccOffset = WavePrefixCountBits(isOccludedCandidate);

            RWByteAddressBuffer counterBuf = ResourceDescriptorHeap[props.counterBufferUav];
            uint visibleCounterOffset = (props.cullPassIndex == 0) ? 0 : 8;

            uint waveVisibleBase = 0;
            if (WaveIsFirstLane() && waveVisibleCount > 0)
            {
                counterBuf.InterlockedAdd(visibleCounterOffset, waveVisibleCount, waveVisibleBase);
            }
            waveVisibleBase = WaveReadLaneFirst(waveVisibleBase);

            uint waveOccBase = 0;
            if (WaveIsFirstLane() && waveOccCount > 0)
            {
                counterBuf.InterlockedAdd(4, waveOccCount, waveOccBase);
            }
            waveOccBase = WaveReadLaneFirst(waveOccBase);

            if (isVisible)
            {
                uint slot = waveVisibleBase + localVisibleOffset;
                if (slot < props.maxVisibleMeshlets)
                {
                    RWStructuredBuffer<VisibleMeshletEntry> visibleBuffer = ResourceDescriptorHeap[props.visibleMeshletsUav];
                    VisibleMeshletEntry entry;
                    entry.instanceIndex = rec.instanceIndex;
                    entry.meshletIndex = rec.meshletIndex;
                    visibleBuffer[slot] = entry;
                }
            }

            if (isOccludedCandidate)
            {
                uint slot = waveOccBase + localOccOffset;
                if (slot < props.maxVisibleMeshlets)
                {
                    RWStructuredBuffer<MeshletCandidateRecord> occludedBuf = ResourceDescriptorHeap[props.occludedMeshletsUav];
                    occludedBuf[slot] = rec;
                }
            }

            // Telemetry counters
            bool frustumCulled = isValid && !inFrustum;
            bool hzbCulled = isValid && inFrustum && isOccluded;

            uint waveTotal = WaveActiveCountBits(isValid);
            uint waveFrustumCulled = WaveActiveCountBits(frustumCulled);
            uint waveHzbCulled = WaveActiveCountBits(hzbCulled);

            if (WaveIsFirstLane())
            {
                if (waveTotal > 0)
                    counterBuf.InterlockedAdd(20, waveTotal);
                if (waveFrustumCulled > 0)
                    counterBuf.InterlockedAdd(24, waveFrustumCulled);
                if (waveHzbCulled > 0)
                    counterBuf.InterlockedAdd(32, waveHzbCulled);
            }
        }
    }

    cs "hlsl_block" : "CSMain";
}