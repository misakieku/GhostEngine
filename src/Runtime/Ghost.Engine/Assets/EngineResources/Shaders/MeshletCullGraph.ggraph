compute "Internal/MeshletCullGraph"
{
    properties
    {
        uint hzbMipCount;
        uint renderWidth;
        uint renderHeight;
        uint cullPassIndex;
        uint visibleMeshletsUav;
        uint visibleMaskedMeshletsUav;
        uint occludedMeshletsUav;
        uint counterBufferUav;
        uint maxVisibleMeshlets;
        float lodErrorThreshold;
        uint instanceCount;
        uint hzbTexture;
        uint hzbBaseWidth;
        uint hzbBaseHeight;
    }

    includes
    {
        "EngineResources/Shaders/Includes/Properties.hlsl";
        "EngineResources/Shaders/Includes/CullCommon.hlsl";
    }

    hlsl
    {
        struct HierarchyNodeRecord
        {
            uint instanceIndex;
            uint nodeIndex;
        };

        struct MeshletGroupRecord
        {
            uint instanceIndex;
            uint groupIndex;
        };

        struct WorkGraphDispatchGridRecord
        {
            uint3 dispatchGrid : SV_DispatchGrid;
        };

        static inline bool TestHZB(float4 clipMin, float4 clipMax, InternalMeshletCullGraphShaderProperties props)
        {
            return HZBVisible(
                clipMin,
                clipMax,
                props.hzbMipCount,
                props.renderWidth,
                props.renderHeight,
                props.hzbTexture,
                props.hzbBaseWidth,
                props.hzbBaseHeight);
        }

        // Node 1: Entry point for instance-level culling in Pass 1
        [Shader("node")]
        [NodeLaunch("broadcasting")]
        [NodeIsProgramEntry]
        [NodeMaxDispatchGrid(65535, 1, 1)]
        [NumThreads(64, 1, 1)]
        void InstanceCullNode(
            DispatchNodeInputRecord<WorkGraphDispatchGridRecord> inputRecord,
            uint3 dispatchThreadId : SV_DispatchThreadID,
            [NodeId("HierarchyTraverseNode")] [MaxRecords(1)] NodeOutput<HierarchyNodeRecord> hierarchyQueue,
            [NodeId("MeshletCullNode")] [MaxRecords(64)] NodeOutput<MeshletCandidateRecord> meshletQueue)
        {
            InternalMeshletCullGraphShaderProperties props = LoadData<InternalMeshletCullGraphShaderProperties>(g_PushConstantData.propertiesBuffer, 0);

            RWByteAddressBuffer counterBuf = ResourceDescriptorHeap[props.counterBufferUav];

            uint instanceIndex = dispatchThreadId.x;
            if (instanceIndex >= props.instanceCount)
            {
                return;
            }

            FrameData frame = LoadData<FrameData>(g_PushConstantData.frameBuffer, 0);
            ViewData view = LoadData<ViewData>(g_PushConstantData.viewBuffer, 0);

            ByteAddressBuffer sceneBuffer = GET_BUFFER(frame.instanceBuffer);
            InstanceData instance = sceneBuffer.Load<InstanceData>(instanceIndex * sizeof(InstanceData));

            if (instance.meshBuffer == 0 || instance.meshBuffer == 0xFFFFFFFF)
            {
                return;
            }

            ByteAddressBuffer meshBuffer = GET_BUFFER(instance.meshBuffer);
            MeshData mesh = meshBuffer.Load<MeshData>(0);

            float3 worldMin, worldMax;
            TransformAABB(mesh.worldBoundsMin, mesh.worldBoundsMax, instance.localToWorld, worldMin, worldMax);

            if (!AABBIntersectFrustum(worldMin, worldMax, view.frustum.planes))
            {
                return;
            }

            if (mesh.meshletHierarchyBuffer != 0)
            {
                ThreadNodeOutputRecords<HierarchyNodeRecord> outRec = hierarchyQueue.GetThreadNodeOutputRecords(1);
                outRec.Get().instanceIndex = instanceIndex;
                outRec.Get().nodeIndex = 0;
                outRec.OutputComplete();
            }
            else
            {
                uint remaining = mesh.meshletCount;
                uint offset = 0;
                while (remaining > 0)
                {
                    uint chunk = min(remaining, 64u);
                    ThreadNodeOutputRecords<MeshletCandidateRecord> outGroup = meshletQueue.GetThreadNodeOutputRecords(chunk);
                    for (uint i = 0; i < chunk; ++i)
                    {
                        outGroup[i].instanceIndex = instanceIndex;
                        outGroup[i].meshletIndex = offset + i;
                        outGroup[i].meshletBufferIndex = mesh.meshletBuffer;
                    }
                    outGroup.OutputComplete();
                    offset += chunk;
                    remaining -= chunk;
                }
            }
        }

        // Node 2: Hierarchical LOD DAG traversal
        [Shader("node")]
        [NodeLaunch("thread")]
        [NodeMaxRecursionDepth(16)]
        void HierarchyTraverseNode(
            ThreadNodeInputRecord<HierarchyNodeRecord> inputRecord,
            [NodeId("HierarchyTraverseNode")] [MaxRecords(7)] NodeOutput<HierarchyNodeRecord> selfQueue,
            [NodeId("ExpandGroupNode")]       [MaxRecords(1)] NodeOutput<MeshletGroupRecord> groupQueue)
        {
            InternalMeshletCullGraphShaderProperties props = LoadData<InternalMeshletCullGraphShaderProperties>(g_PushConstantData.propertiesBuffer, 0);
            HierarchyNodeRecord rec = inputRecord.Get();

            FrameData frame = LoadData<FrameData>(g_PushConstantData.frameBuffer, 0);
            ViewData view = LoadData<ViewData>(g_PushConstantData.viewBuffer, 0);

            ByteAddressBuffer sceneBuffer = GET_BUFFER(frame.instanceBuffer);
            InstanceData instance = sceneBuffer.Load<InstanceData>(rec.instanceIndex * sizeof(InstanceData));

            ByteAddressBuffer meshBuffer = GET_BUFFER(instance.meshBuffer);
            MeshData mesh = meshBuffer.Load<MeshData>(0);

            ByteAddressBuffer hierarchyBuf = GET_BUFFER(mesh.meshletHierarchyBuffer);
            MeshletHierarchyNode node = hierarchyBuf.Load<MeshletHierarchyNode>(rec.nodeIndex * sizeof(MeshletHierarchyNode));

            // 1. Frustum culling with bounding sphere
            float3 scale3 = float3(
                length(instance.localToWorld._m00_m10_m20),
                length(instance.localToWorld._m01_m11_m21),
                length(instance.localToWorld._m02_m12_m22));
            float maxScale = max(scale3.x, max(scale3.y, scale3.z));

            float3 worldCenter = mul(instance.localToWorld, float4(node.bounds.xyz, 1.0f)).xyz;
            float worldRadius = node.bounds.w * maxScale;

            if (!SphereIntersectFrustum(worldCenter, worldRadius, view.frustum.planes))
            {
                return;
            }

            // 2. Dual-Error Parent Error Pruning:
            // If the parent (coarser LOD) error already satisfies the screen-space threshold,
            // the coarser representation is sufficient and this subtree can be pruned.
            bool isParentDetailSufficient = (node.error < 3.4e38f) && EvaluateLODDetailSufficient(
                node.error * maxScale,
                worldCenter,
                worldRadius,
                view.cameraPosition,
                view.projectionMatrix[1][1],
                view.screenSize.y,
                props.lodErrorThreshold);

            if (isParentDetailSufficient)
            {
                return; // Prune branch: coarser LOD is sufficient
            }

            if (node.groupIndex < 0)
            {
                // Internal node: traverse into children
                uint childCount = min(node.childCount, 7u);
                if (childCount > 0)
                {
                    ThreadNodeOutputRecords<HierarchyNodeRecord> outChildren = selfQueue.GetThreadNodeOutputRecords(childCount);
                    for (uint c = 0; c < childCount; ++c)
                    {
                        outChildren[c].instanceIndex = rec.instanceIndex;
                        outChildren[c].nodeIndex = node.childOffset + c;
                    }
                    outChildren.OutputComplete();
                }
            }
            else
            {
                if (node.groupIndex >= 0)
                {
                    ThreadNodeOutputRecords<MeshletGroupRecord> outGroup = groupQueue.GetThreadNodeOutputRecords(1);
                    outGroup.Get().instanceIndex = rec.instanceIndex;
                    outGroup.Get().groupIndex = (uint)node.groupIndex;
                    outGroup.OutputComplete();
                }
            }
        }

        [Shader("node")]
        [NodeLaunch("broadcasting")]
        [NodeDispatchGrid(1, 1, 1)]
        [NumThreads(32, 1, 1)]
        void ExpandGroupNode(
            DispatchNodeInputRecord<MeshletGroupRecord> inputRecord,
            uint groupThreadId : SV_GroupThreadID,
            [NodeId("MeshletCullNode")] [MaxRecords(32)] NodeOutput<MeshletCandidateRecord> meshletQueue)
        {
            MeshletGroupRecord rec = inputRecord.Get();

            FrameData frame = LoadData<FrameData>(g_PushConstantData.frameBuffer, 0);
            ByteAddressBuffer sceneBuffer = GET_BUFFER(frame.instanceBuffer);
            InstanceData instance = sceneBuffer.Load<InstanceData>(rec.instanceIndex * sizeof(InstanceData));
            ByteAddressBuffer meshBuffer = GET_BUFFER(instance.meshBuffer);
            MeshData mesh = meshBuffer.Load<MeshData>(0);

            ByteAddressBuffer groupBuf = GET_BUFFER(mesh.meshletGroupBuffer);
            MeshletGroup group = groupBuf.Load<MeshletGroup>(rec.groupIndex * sizeof(MeshletGroup));

            if (groupThreadId < group.meshletCount)
            {
                ThreadNodeOutputRecords<MeshletCandidateRecord> outRec = meshletQueue.GetThreadNodeOutputRecords(1);
                outRec.Get().instanceIndex = rec.instanceIndex;
                outRec.Get().meshletIndex = group.meshletStartIndex + groupThreadId;
                outRec.Get().meshletBufferIndex = mesh.meshletBuffer;
                outRec.OutputComplete();
            }
        }

        // Node 3: Coalesced fine cluster/meshlet culling with wave compaction (32x reduction in atomics)
        [Shader("node")]
        [NodeLaunch("coalescing")]
        [NumThreads(32, 1, 1)]
        void MeshletCullNode(
            [MaxRecords(32)] GroupNodeInputRecords<MeshletCandidateRecord> inputRecords,
            uint groupIndex : SV_GroupIndex)
        {
            InternalMeshletCullGraphShaderProperties props = LoadData<InternalMeshletCullGraphShaderProperties>(g_PushConstantData.propertiesBuffer, 0);

            uint numRecords = inputRecords.Count();
            bool isValid = (groupIndex < numRecords);
            MeshletCandidateRecord rec = (MeshletCandidateRecord)0;
            if (isValid)
            {
                rec = inputRecords.Get(groupIndex);
            }

            bool isVisible = false;
            uint renderType = 0;
            bool inFrustum = false;
            bool isOccluded = false;

            if (isValid)
            {
                FrameData frame = LoadData<FrameData>(g_PushConstantData.frameBuffer, 0);
                ViewData view = LoadData<ViewData>(g_PushConstantData.viewBuffer, 0);

                ByteAddressBuffer sceneBuffer = GET_BUFFER(frame.instanceBuffer);
                InstanceData instance = sceneBuffer.Load<InstanceData>(rec.instanceIndex * sizeof(InstanceData));

                ByteAddressBuffer meshletBuf = GET_BUFFER(rec.meshletBufferIndex);
                Meshlet meshlet = meshletBuf.Load<Meshlet>(rec.meshletIndex * sizeof(Meshlet));

                float3 scale3 = float3(
                    length(instance.localToWorld._m00_m10_m20),
                    length(instance.localToWorld._m01_m11_m21),
                    length(instance.localToWorld._m02_m12_m22));
                float maxScale = max(scale3.x, max(scale3.y, scale3.z));

                float3 meshletWorldCenter = mul(instance.localToWorld, float4(meshlet.boundingSphere.xyz, 1.0f)).xyz;
                float meshletWorldRadius = meshlet.boundingSphere.w * maxScale;

                float3 meshletParentWorldCenter = mul(instance.localToWorld, float4(meshlet.parentBoundingSphere.xyz, 1.0f)).xyz;
                float meshletParentWorldRadius = meshlet.parentBoundingSphere.w * maxScale;

                // Dual-Error Cut Condition 1: Parent Error check (Lower bound)
                // If parent (coarser LOD) is already accurate enough, this fine meshlet must NOT render!
                bool isParentDetailSufficient = (meshlet.parentError < 3.4e38f) && EvaluateLODDetailSufficient(
                    meshlet.parentError * maxScale,
                    meshletParentWorldCenter,
                    meshletParentWorldRadius,
                    view.cameraPosition,
                    view.projectionMatrix[1][1],
                    view.screenSize.y,
                    props.lodErrorThreshold);

                // Dual-Error Cut Condition 2: Cluster Error test (Upper bound)
                // Discard meshlets that are too coarse; their error exceeds the threshold,
                // so a finer LOD level must render instead.
                bool isClusterDetailSufficient = (meshlet.clusterError <= 0.0f) || EvaluateLODDetailSufficient(
                    meshlet.clusterError * maxScale,
                    meshletWorldCenter,
                    meshletWorldRadius,
                    view.cameraPosition,
                    view.projectionMatrix[1][1],
                    view.screenSize.y,
                    props.lodErrorThreshold);

                if (isParentDetailSufficient || !isClusterDetailSufficient)
                {
                    isValid = false;
                }
                else
                {
                    uint localMaterialIndex = (meshlet.packedCounts >> 16) & 0xFFu;
                    uint packedMaterial = LoadMaterialBindlessIndex(frame.paletteOffsetBuffer, frame.materialIndexBuffer, instance.materialPaletteIndex, localMaterialIndex);
                    renderType = (packedMaterial >> 24) & 0xFFu;

                    float4 clipMin, clipMax;
                    bool clipValid;
                    inFrustum = BBoxIntersectFrustum(meshlet.boundingBoxMin, meshlet.boundingBoxMax, instance.localToWorld, view.viewProjectionMatrix, clipMin, clipMax, clipValid);
                    if (inFrustum)
                    {
                        if (props.hzbMipCount > 0)
                        {
                            if (props.cullPassIndex == 0)
                            {
                                float4 prevClipMin, prevClipMax;
                                bool prevClipValid;
                                bool wasInPrevFrustum = BBoxIntersectFrustum(meshlet.boundingBoxMin, meshlet.boundingBoxMax, instance.localToWorld, view.preVPMatrix, prevClipMin, prevClipMax, prevClipValid);

                                if (wasInPrevFrustum && prevClipValid)
                                {
                                    isOccluded = !TestHZB(prevClipMin, prevClipMax, props);
                                }
                                else
                                {
                                    isOccluded = true;
                                }
                            }
                            else if (clipValid)
                            {
                                isOccluded = !TestHZB(clipMin, clipMax, props);
                            }
                        }
                        isVisible = !isOccluded;
                    }
                }
            }

            // Wave compaction for Opaque vs Masked visible meshlets
            bool isOpaque = isVisible && (renderType != 1);
            bool isMasked = isVisible && (renderType == 1);

            uint waveOpaqueCount = WaveActiveCountBits(isOpaque);
            uint localOpaqueOffset = WavePrefixCountBits(isOpaque);

            uint waveMaskedCount = WaveActiveCountBits(isMasked);
            uint localMaskedOffset = WavePrefixCountBits(isMasked);

            // In Pass 1: queue occluded meshlets to be re-evaluated in Pass 2 against current HZB
            bool isOccludedCandidate = (props.cullPassIndex == 0) && isValid && inFrustum && isOccluded;
            uint waveOccCount = WaveActiveCountBits(isOccludedCandidate);
            uint localOccOffset = WavePrefixCountBits(isOccludedCandidate);

            RWByteAddressBuffer counterBuf = ResourceDescriptorHeap[props.counterBufferUav];
            uint opaqueCounterOffset = (props.cullPassIndex == 0) ? 0 : 8;
            uint maskedCounterOffset = (props.cullPassIndex == 0) ? 12 : 16;

            uint waveOpaqueBase = 0;
            if (WaveIsFirstLane() && waveOpaqueCount > 0)
            {
                counterBuf.InterlockedAdd(opaqueCounterOffset, waveOpaqueCount, waveOpaqueBase);
            }
            waveOpaqueBase = WaveReadLaneFirst(waveOpaqueBase);

            uint waveMaskedBase = 0;
            if (WaveIsFirstLane() && waveMaskedCount > 0)
            {
                counterBuf.InterlockedAdd(maskedCounterOffset, waveMaskedCount, waveMaskedBase);
            }
            waveMaskedBase = WaveReadLaneFirst(waveMaskedBase);

            uint waveOccBase = 0;
            if (WaveIsFirstLane() && waveOccCount > 0)
            {
                counterBuf.InterlockedAdd(4, waveOccCount, waveOccBase);
            }
            waveOccBase = WaveReadLaneFirst(waveOccBase);

            // Telemetry counters
            bool frustumCulled = isValid && !inFrustum;
            bool hzbCulled = isValid && inFrustum && isOccluded;

            uint waveTotal = WaveActiveCountBits(isValid);
            uint waveFrustumCulled = WaveActiveCountBits(frustumCulled);
            uint waveHzbCulled = WaveActiveCountBits(hzbCulled);

            if (WaveIsFirstLane())
            {
                if (waveTotal > 0) counterBuf.InterlockedAdd(20, waveTotal);
                if (waveFrustumCulled > 0) counterBuf.InterlockedAdd(24, waveFrustumCulled);
                if (waveHzbCulled > 0) counterBuf.InterlockedAdd(32, waveHzbCulled);
            }

            if (isOpaque)
            {
                uint slot = waveOpaqueBase + localOpaqueOffset;
                if (slot < props.maxVisibleMeshlets)
                {
                    RWStructuredBuffer<VisibleMeshletEntry> visibleBuffer = ResourceDescriptorHeap[props.visibleMeshletsUav];
                    VisibleMeshletEntry entry;
                    entry.instanceIndex = rec.instanceIndex;
                    entry.meshletIndex = rec.meshletIndex;
                    visibleBuffer[slot] = entry;
                }
            }
            else if (isMasked)
            {
                uint slot = waveMaskedBase + localMaskedOffset;
                if (slot < props.maxVisibleMeshlets)
                {
                    RWStructuredBuffer<VisibleMeshletEntry> maskedBuffer = ResourceDescriptorHeap[props.visibleMaskedMeshletsUav];
                    VisibleMeshletEntry entry;
                    entry.instanceIndex = rec.instanceIndex;
                    entry.meshletIndex = rec.meshletIndex;
                    maskedBuffer[slot] = entry;
                }
            }

            if (isOccludedCandidate)
            {
                uint slot = waveOccBase + localOccOffset;
                if (slot < props.maxVisibleMeshlets)
                {
                    RWStructuredBuffer<MeshletCandidateRecord> occludedBuf = ResourceDescriptorHeap[props.occludedMeshletsUav];
                    occludedBuf[slot] = rec;
                }
            }
        }
    }

    cs "hlsl_block" : "CSMain";
}
