compute "Internal/ScatterMeshlets"
{
    properties
    {
        uint unbinnedBuffer;
        uint binnedBuffer;
        uint binScatterCounters;
        uint counterBuffer;
        uint totalVisibleOffset;
        uint maxVisibleMeshlets;
        uint isShadowPass;
    }

    includes
    {
        "EngineResources/Shaders/Properties.hlsl";
        "EngineResources/Shaders/Utilities/CullCommon.hlsl";
    }

    hlsl
    {
        [numthreads(64, 1, 1)]
        void CSMain(uint3 dispatchThreadId : SV_DispatchThreadID)
        {

            RWByteAddressBuffer counterBuf = GET_BUFFER(g_Properties.counterBuffer);
            uint totalVisible = counterBuf.Load(g_Properties.totalVisibleOffset);
            if (totalVisible > g_Properties.maxVisibleMeshlets)
            {
                totalVisible = g_Properties.maxVisibleMeshlets;
            }

            uint slotIndex = dispatchThreadId.y * 4194240u + dispatchThreadId.x;
            if (slotIndex >= totalVisible)
            {
                return;
            }

            StructuredBuffer<UnbinnedMeshletEntry> unbinned = GET_BUFFER(g_Properties.unbinnedBuffer);
            UnbinnedMeshletEntry entry = unbinned[slotIndex];

            uint binIndex = (g_Properties.isShadowPass != 0u) ? (entry.variantIndex >> 16u) : entry.variantIndex;

            RWByteAddressBuffer scatterCounters = GET_BUFFER(g_Properties.binScatterCounters);
            uint dstSlot;
            scatterCounters.InterlockedAdd(binIndex * 4u, 1u, dstSlot);

            if (dstSlot < g_Properties.maxVisibleMeshlets)
            {
                if (g_Properties.isShadowPass != 0u)
                {
                    RWStructuredBuffer<UnbinnedMeshletEntry> binnedShadow = GET_BUFFER(g_Properties.binnedBuffer);
                    binnedShadow[dstSlot] = entry;
                }
                else
                {
                    RWStructuredBuffer<VisibleMeshletEntry> binnedScene = GET_BUFFER(g_Properties.binnedBuffer);
                    VisibleMeshletEntry visible;
                    visible.instanceIndex = entry.instanceIndex;
                    visible.meshletIndex = entry.meshletIndex;
                    binnedScene[dstSlot] = visible;
                }
            }
        }
    }

    cs "hlsl_block" : "CSMain";
}
