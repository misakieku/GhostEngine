compute "Internal/PrepareShadowIndirectArgs"
{
    properties
    {
        uint counterBuffer;
        uint indirectArgsBuffer;
        uint maxCount;
        uint maxVariants;
    }

    includes
    {
        "EngineResources/Shaders/Properties.hlsl";
    }

    hlsl
    {
        [numthreads(64, 1, 1)]
        void CSMain(uint3 dispatchThreadId : SV_DispatchThreadID)
        {

            RWByteAddressBuffer counterBuf = GET_BUFFER(g_Properties.counterBuffer);
            RWByteAddressBuffer indirectArgsBuf = GET_BUFFER(g_Properties.indirectArgsBuffer);

            uint v = dispatchThreadId.x;
            if (v == 0u)
            {
                uint count = counterBuf.Load(0);
                if (count > g_Properties.maxCount)
                {
                    count = g_Properties.maxCount;
                }

                // D3D12_DISPATCH_MESH_ARGUMENTS: ThreadGroupCountX, ThreadGroupCountY, ThreadGroupCountZ
                indirectArgsBuf.Store3(0, uint3(count, 1, 1));
            }
            else if (v < g_Properties.maxVariants)
            {
                indirectArgsBuf.Store3(v * 16u, uint3(0, 0, 0));
            }
        }
    }

    cs "hlsl_block" : "CSMain";
}
