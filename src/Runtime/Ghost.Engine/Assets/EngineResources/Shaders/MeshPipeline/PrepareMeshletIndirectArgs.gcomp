compute "Internal/PrepareMeshletIndirectArgs"
{
    properties
    {
        uint counterBuffer;
        uint indirectArgsBuffer;
        uint visibleCountOffset;
        uint visibleArgsOffset;
        uint maxCount;
        uint occludedCountOffset;
        uint cullArgsOffset;
    }

    includes
    {
        "EngineResources/Shaders/Properties.hlsl";
    }

    hlsl
    {
        [numthreads(2, 1, 1)]
        void CSMain(uint3 dispatchThreadID : SV_DispatchThreadID)
        {
            InternalPrepareMeshletIndirectArgsShaderProperties properties = LoadData<InternalPrepareMeshletIndirectArgsShaderProperties>(g_PushConstantData.userData0, 0);

            RWByteAddressBuffer counterBuffer = ResourceDescriptorHeap[properties.counterBuffer];
            RWByteAddressBuffer indirectArgsBuffer = ResourceDescriptorHeap[properties.indirectArgsBuffer];

            if (dispatchThreadID.x == 0)
            {
                uint visibleCount = counterBuffer.Load(properties.visibleCountOffset);
                if (visibleCount > properties.maxCount)
                {
                    visibleCount = properties.maxCount;
                }

                // D3D12_DISPATCH_MESH_ARGUMENTS: ThreadGroupCountX, ThreadGroupCountY, ThreadGroupCountZ
                indirectArgsBuffer.Store3(properties.visibleArgsOffset, uint3(visibleCount, 1, 1));
            }
            else if (dispatchThreadID.x == 1)
            {
                if (properties.cullArgsOffset != 0xFFFFFFFF && properties.occludedCountOffset != 0xFFFFFFFF)
                {
                    uint occludedCount = counterBuffer.Load(properties.occludedCountOffset);
                    if (occludedCount > properties.maxCount)
                    {
                        occludedCount = properties.maxCount;
                    }

                    uint threadGroupCountX = (occludedCount + 63) / 64;
                    // D3D12_DISPATCH_ARGUMENTS: ThreadGroupCountX, ThreadGroupCountY, ThreadGroupCountZ
                    indirectArgsBuffer.Store3(properties.cullArgsOffset, uint3(threadGroupCountX, 1, 1));
                }
            }
        }
    }

    cs "hlsl_block" : "CSMain";
}
