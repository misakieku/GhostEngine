compute "Internal/PrepareMeshletIndirectArgs"
{
    properties
    {
        uint counterBuffer;
        uint indirectArgsBuffer;
        uint binOffsetsBuffer;
        uint binScatterCounters;
        uint variantCountsOffset;
        uint visibleArgsOffset;
        uint maxCount;
        uint maxVariants;
        uint occludedCountOffset;
        uint cullArgsOffset;
        uint swArgsOffset;
    }

    includes
    {
        "EngineResources/Shaders/Properties.hlsl";
    }

    hlsl
    {
        #define SCAN_THREADS 1024
 
        groupshared uint s_scan[SCAN_THREADS];
 
        [numthreads(SCAN_THREADS, 1, 1)]
        void CSMain(uint3 dispatchThreadID : SV_DispatchThreadID)
        {

            RWByteAddressBuffer counterBuffer = GET_BUFFER(g_Properties.counterBuffer);
            RWByteAddressBuffer indirectArgsBuffer = GET_BUFFER(g_Properties.indirectArgsBuffer);
            RWByteAddressBuffer binOffsets = GET_BUFFER(g_Properties.binOffsetsBuffer);
            RWByteAddressBuffer binCounters = GET_BUFFER(g_Properties.binScatterCounters);

            uint v = dispatchThreadID.x;
            uint count = 0;
            if (v < g_Properties.maxVariants)
            {
                count = counterBuffer.Load(g_Properties.variantCountsOffset + v * 4u);
                if (count > g_Properties.maxCount)
                {
                    count = g_Properties.maxCount;
                }
            }

            s_scan[v] = count;
            GroupMemoryBarrierWithGroupSync();

            // Parallel inclusive prefix sum (Hillis-Steele algorithm)
            [unroll]
            for (uint stride = 1; stride < SCAN_THREADS; stride <<= 1)
            {
                uint temp = 0;
                if (v >= stride)
                {
                    temp = s_scan[v - stride];
                }
                GroupMemoryBarrierWithGroupSync();
                s_scan[v] += temp;
                GroupMemoryBarrierWithGroupSync();
            }

            // Convert inclusive scan to exclusive prefix sum
            uint exclusiveOffset = (v > 0) ? s_scan[v - 1] : 0;

            if (v < g_Properties.maxVariants)
            {
                binOffsets.Store(v * 4u, exclusiveOffset);
                binCounters.Store(v * 4u, exclusiveOffset);

                // D3D12_DISPATCH_MESH_ARGUMENTS: ThreadGroupCountX, ThreadGroupCountY, ThreadGroupCountZ
                indirectArgsBuffer.Store3(g_Properties.visibleArgsOffset + v * 16u, uint3(count, 1, 1));
            }

            // Thread 0 also prepares the Pass 2 cull dispatch arguments if requested and SW rasterizer dispatch
            if (v == 0)
            {
                // Total HW Opaque is sum of bins 0..31 (s_scan[31] after inclusive scan)
                uint totalHwOpaque = s_scan[31];
                if (totalHwOpaque > g_Properties.maxCount)
                {
                    totalHwOpaque = g_Properties.maxCount;
                }
                indirectArgsBuffer.Store3(g_Properties.visibleArgsOffset, uint3(totalHwOpaque, 1, 1));

                // Total SW Opaque is sum of bins 32..63 (s_scan[63] minus s_scan[31])
                uint totalSwOpaque = s_scan[63] - s_scan[31];
                if (totalSwOpaque > g_Properties.maxCount)
                {
                    totalSwOpaque = g_Properties.maxCount;
                }
                if (g_Properties.swArgsOffset != 0xFFFFFFFF)
                {
                    // D3D12_DISPATCH_ARGUMENTS: ThreadGroupCountX, ThreadGroupCountY, ThreadGroupCountZ
                    indirectArgsBuffer.Store3(g_Properties.swArgsOffset, uint3(totalSwOpaque, 1, 1));
                }

                if (g_Properties.cullArgsOffset != 0xFFFFFFFF && g_Properties.occludedCountOffset != 0xFFFFFFFF)
                {
                    uint occludedCount = counterBuffer.Load(g_Properties.occludedCountOffset);
                    if (occludedCount > g_Properties.maxCount)
                    {
                        occludedCount = g_Properties.maxCount;
                    }

                    uint threadGroupCountX = (occludedCount + 63) / 64;
                    // D3D12_DISPATCH_ARGUMENTS: ThreadGroupCountX, ThreadGroupCountY, ThreadGroupCountZ
                    indirectArgsBuffer.Store3(g_Properties.cullArgsOffset, uint3(threadGroupCountX, 1, 1));
                }
            }
        }
    }

    cs "hlsl_block" : "CSMain";
}
