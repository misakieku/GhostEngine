compute "Internal/PrepareMeshletIndirectArgs"
{
    properties
    {
        uint counterBuffer;
        uint indirectArgsBuffer;
        uint binOffsetsBuffer;
        uint binScatterCounters;
        uint variantCountsOffset;
        uint visibleArgsOffset;
        uint maxCount;
        uint maxVariants;
        uint occludedCountOffset;
        uint cullArgsOffset;
    }

    includes
    {
        "EngineResources/Shaders/Properties.hlsl";
    }

    hlsl
    {
        #define SCAN_THREADS 256

        groupshared uint s_scan[SCAN_THREADS];

        [numthreads(SCAN_THREADS, 1, 1)]
        void CSMain(uint3 dispatchThreadID : SV_DispatchThreadID)
        {
            InternalPrepareMeshletIndirectArgsShaderProperties properties = LoadData<InternalPrepareMeshletIndirectArgsShaderProperties>(g_PushConstantData.userData0, 0);

            RWByteAddressBuffer counterBuffer = ResourceDescriptorHeap[properties.counterBuffer];
            RWByteAddressBuffer indirectArgsBuffer = ResourceDescriptorHeap[properties.indirectArgsBuffer];
            RWByteAddressBuffer binOffsets = ResourceDescriptorHeap[properties.binOffsetsBuffer];
            RWByteAddressBuffer binCounters = ResourceDescriptorHeap[properties.binScatterCounters];

            uint v = dispatchThreadID.x;
            uint count = 0;
            if (v < properties.maxVariants)
            {
                count = counterBuffer.Load(properties.variantCountsOffset + v * 4u);
                if (count > properties.maxCount)
                {
                    count = properties.maxCount;
                }
            }

            s_scan[v] = count;
            GroupMemoryBarrierWithGroupSync();

            // Parallel inclusive prefix sum (Hillis-Steele algorithm)
            [unroll]
            for (uint stride = 1; stride < SCAN_THREADS; stride <<= 1)
            {
                uint temp = 0;
                if (v >= stride)
                {
                    temp = s_scan[v - stride];
                }
                GroupMemoryBarrierWithGroupSync();
                s_scan[v] += temp;
                GroupMemoryBarrierWithGroupSync();
            }

            // Convert inclusive scan to exclusive prefix sum
            uint exclusiveOffset = (v > 0) ? s_scan[v - 1] : 0;

            if (v < properties.maxVariants)
            {
                binOffsets.Store(v * 4u, exclusiveOffset);
                binCounters.Store(v * 4u, exclusiveOffset);

                // D3D12_DISPATCH_MESH_ARGUMENTS: ThreadGroupCountX, ThreadGroupCountY, ThreadGroupCountZ
                indirectArgsBuffer.Store3(properties.visibleArgsOffset + v * 16u, uint3(count, 1, 1));
            }

            // Thread 0 also prepares the Pass 2 cull dispatch arguments if requested
            if (v == 0)
            {
                if (properties.cullArgsOffset != 0xFFFFFFFF && properties.occludedCountOffset != 0xFFFFFFFF)
                {
                    uint occludedCount = counterBuffer.Load(properties.occludedCountOffset);
                    if (occludedCount > properties.maxCount)
                    {
                        occludedCount = properties.maxCount;
                    }

                    uint threadGroupCountX = (occludedCount + 63) / 64;
                    // D3D12_DISPATCH_ARGUMENTS: ThreadGroupCountX, ThreadGroupCountY, ThreadGroupCountZ
                    indirectArgsBuffer.Store3(properties.cullArgsOffset, uint3(threadGroupCountX, 1, 1));
                }
            }
        }
    }

    cs "hlsl_block" : "CSMain";
}
