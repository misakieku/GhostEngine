compute "Internal/OccludedMeshletCull"
{
    properties
    {
        uint hzbMipCount;
        uint renderWidth;
        uint renderHeight;
        uint visibleMeshletsUav;
        uint occludedMeshletsUav;
        uint counterBufferUav;
        uint maxVisibleMeshlets;
        uint hzbTexture;
        uint hzbBaseWidth;
        uint hzbBaseHeight;
    }

    includes
    {
        "EngineResources/Shaders/Properties.hlsl";
        "EngineResources/Shaders/Mesh.hlsl";
        "EngineResources/Shaders/Utilities/CullCommon.hlsl";
        "EngineResources/Shaders/MaterialPipeline/MaterialEncoding.hlsl";
    }

    hlsl
    {
        bool TestHZB(float4 clipMin, float4 clipMax)
        {
            return HZBVisible(clipMin, clipMax, g_Properties.hzbMipCount, g_Properties.renderWidth, g_Properties.renderHeight, g_Properties.hzbTexture, g_Properties.hzbBaseWidth, g_Properties.hzbBaseHeight);
        }

        [numthreads(64, 1, 1)]
        void CSMain(uint3 dispatchThreadId : SV_DispatchThreadID)
        {

            RWByteAddressBuffer counterBuf = GET_BUFFER(g_Properties.counterBufferUav);
            uint occludedCount = counterBuf.Load(4);

            uint slotIndex = dispatchThreadId.x;
            bool isValid = (slotIndex < occludedCount);

            bool isVisible = false;
            uint variantIndex = 0;
            uint cullBin = 0;
            MeshletCandidateRecord rec = (MeshletCandidateRecord)0;

            if (isValid)
            {
                StructuredBuffer<MeshletCandidateRecord> occludedBuffer = GET_BUFFER(g_Properties.occludedMeshletsUav);
                rec = occludedBuffer[slotIndex];

                InstanceData instance = LoadData<InstanceData>(g_FrameData.sceneBuffer, rec.instanceIndex);
                MeshData meshData = LoadData<MeshData>(instance.meshBuffer, 0);
                Meshlet meshlet = LoadMeshlet(rec.meshletIndex, meshData);

                uint localMaterialIndex = (meshlet.packedCounts >> 16u) & 0xFFu;
                uint packedMaterial = LoadMaterialBindlessIndex(g_FrameData.paletteOffsetBuffer, g_FrameData.materialIndexBuffer, instance.materialPaletteIndex, localMaterialIndex);
                variantIndex = UnpackMaterialVariantIndex(packedMaterial);
                uint hasAlpha = UnpackMaterialHasAlpha(packedMaterial);
                cullBin = (hasAlpha != 0u) ? (variantIndex + 1u) : 0u;

                float4x4 localToRWS = ApplyCameraTranslationToMatrix(instance.localToWorld);
                BBoxFrustumResult cullResult = BBoxIntersectFrustum<false>(meshlet.boundingBoxMin, meshlet.boundingBoxMax, localToRWS);
                if (cullResult.isVisible)
                {
                    if (cullResult.clipValid && g_Properties.hzbMipCount > 0)
                    {
                        isVisible = TestHZB(cullResult.clipMin, cullResult.clipMax);
                        // isVisible = true;
                    }
                    else
                    {
                        isVisible = true;
                    }
                }
            }

            uint waveVisibleCount = WaveActiveCountBits(isVisible);
            uint localVisibleOffset = WavePrefixCountBits(isVisible);

            uint waveVisibleBase = 0;
            if (WaveIsFirstLane() && waveVisibleCount > 0)
            {
                counterBuf.InterlockedAdd(8, waveVisibleCount, waveVisibleBase);
            }
            waveVisibleBase = WaveReadLaneFirst(waveVisibleBase);

            if (isVisible)
            {
                uint slot = waveVisibleBase + localVisibleOffset;
                if (slot < g_Properties.maxVisibleMeshlets)
                {
                    RWStructuredBuffer<UnbinnedMeshletEntry> visibleBuffer = GET_BUFFER(g_Properties.visibleMeshletsUav);
                    UnbinnedMeshletEntry entry;
                    entry.instanceIndex = rec.instanceIndex;
                    entry.meshletIndex = rec.meshletIndex;
                    entry.variantIndex = cullBin;
                    visibleBuffer[slot] = entry;
                }
            }

            // Count visible meshlets per cull bin for prefix-sum binning in Pass 2 (Bin 0 is opaque, Bins 1..N are alpha-clip variants)
            uint activeMask = WaveActiveBallot(isVisible).x;
            while (activeMask != 0)
            {
                uint firstLane = firstbitlow(activeMask);
                uint v = WaveReadLaneAt(cullBin, firstLane);
                bool match = isVisible && (cullBin == v);
                uint count = WaveActiveCountBits(match);

                if (WaveGetLaneIndex() == firstLane && v < MAX_CULL_VARIANTS)
                {
                    counterBuf.InterlockedAdd(OFFSET_PASS2_VARIANT_COUNTS + v * 4u, count);
                }
                activeMask &= ~WaveActiveBallot(match).x;
            }
        }
    }

    cs "hlsl_block" : "CSMain";
}
