compute "Internal/BuildHZB"
{
    properties
    {
        uint srcBuffer;
        uint srcUavMip;
        uint dstUavMip0;
        uint dstUavMip1;
        uint dstUavMip2;
        uint dstUavMip3;
        uint minDstCount;
        uint isFirstBatch;
        uint2 srcLimit;
        uint2 _padding;
        uint4 dstSize01;
        uint4 dstSize23;
    }

    includes
    {
        "EngineResources/Shaders/Properties.hlsl";
        "EngineResources/Shaders/MaterialPipeline/VisibilityBufferEncoding.hlsl";
    }

    hlsl
    {
        uint2 CoordInTileByIndex(uint i)
        {
            // Decode i = [yxxyyx] into Morton 2D coordinate inside 8x8 tile
            return uint2(
                (i & 1) | ((i >> 2) & 6),
                ((i >> 1) & 3) | ((i >> 3) & 4));
        }

        groupshared float s_minDepth[32];
        
        void SubgroupMergeDepths(uint threadID, uint bitIndex, inout float minDepth)
        {
            uint highIndex = threadID >> (bitIndex + 1);
            uint lowIndex = threadID & ((1 << (bitIndex + 1)) - 1);
        
            if (lowIndex == (1 << bitIndex))
            {
                s_minDepth[highIndex] = minDepth;
            }
            GroupMemoryBarrierWithGroupSync();
        
            if (lowIndex == 0)
            {
                minDepth = min(minDepth, s_minDepth[highIndex]);
            }
            GroupMemoryBarrierWithGroupSync();
        }
        
        [numthreads(64, 1, 1)]
        void CSMain(
            uint threadID : SV_GroupThreadID,
            uint3 groupID : SV_GroupID)
        {

            int2 dstCoord0 = (int2)((groupID.xy << 3) | CoordInTileByIndex(threadID));
            int2 readOffsetUL = dstCoord0 << 1;

            int2 srcCoord00 = readOffsetUL + int2(0, 0);
            int2 srcCoord10 = readOffsetUL + int2(1, 0);
            int2 srcCoord01 = readOffsetUL + int2(0, 1);
            int2 srcCoord11 = readOffsetUL + int2(1, 1);

            float p00, p10, p01, p11;
            if (g_Properties.isFirstBatch != 0)
            {
                Texture2D<uint2> visBuffer = GET_TEXTURE2D(g_Properties.srcBuffer);
                p00 = srcCoord00.x < g_Properties.srcLimit.x && srcCoord00.y < g_Properties.srcLimit.y ? asfloat(visBuffer[srcCoord00].y) : 0.0;
                p10 = srcCoord10.x < g_Properties.srcLimit.x && srcCoord10.y < g_Properties.srcLimit.y ? asfloat(visBuffer[srcCoord10].y) : 0.0;
                p01 = srcCoord01.x < g_Properties.srcLimit.x && srcCoord01.y < g_Properties.srcLimit.y ? asfloat(visBuffer[srcCoord01].y) : 0.0;
                p11 = srcCoord11.x < g_Properties.srcLimit.x && srcCoord11.y < g_Properties.srcLimit.y ? asfloat(visBuffer[srcCoord11].y) : 0.0;
            }
            else
            {
                RWTexture2D<float> srcMip = GET_TEXTURE2D(g_Properties.srcUavMip);
                p00 = srcMip[srcCoord00];
                p10 = srcMip[srcCoord10];
                p01 = srcMip[srcCoord01];
                p11 = srcMip[srcCoord11];
            }

            float minDepth = min(min(p00, p10), min(p01, p11));

            // Write Mip 0
            if (g_Properties.minDstCount >= 1 && all(dstCoord0 < (int2)g_Properties.dstSize01.xy))
            {
                RWTexture2D<float> dstMip0 = GET_TEXTURE2D(g_Properties.dstUavMip0);
                dstMip0[dstCoord0] = minDepth;
            }

            // Merge to thread 0 in subgroup size 4 (Mip 1)
            // SubgroupMergeDepths(threadID, 0, minDepth);
            // SubgroupMergeDepths(threadID, 1, minDepth);
            // Use QuadReadAcrossX and QuadReadAcrossY to avoid shared memory and sync
            minDepth = min(minDepth, QuadReadAcrossX(minDepth));
            minDepth = min(minDepth, QuadReadAcrossY(minDepth));
            if (g_Properties.minDstCount >= 2 && (threadID & 0x3) == 0)
            {
                int2 dstCoord1 = dstCoord0 >> 1;
                if (all(dstCoord1 < (int2)g_Properties.dstSize01.zw))
                {
                    RWTexture2D<float> dstMip1 = GET_TEXTURE2D(g_Properties.dstUavMip1);
                    dstMip1[dstCoord1] = minDepth;
                }
            }

            // Merge to thread 0 in subgroup size 16 (Mip 2)
            SubgroupMergeDepths(threadID, 2, minDepth);
            SubgroupMergeDepths(threadID, 3, minDepth);
            if (g_Properties.minDstCount >= 3 && (threadID & 0xF) == 0)
            {
                int2 dstCoord2 = dstCoord0 >> 2;
                if (all(dstCoord2 < (int2)g_Properties.dstSize23.xy))
                {
                    RWTexture2D<float> dstMip2 = GET_TEXTURE2D(g_Properties.dstUavMip2);
                    dstMip2[dstCoord2] = minDepth;
                }
            }

            // Merge to thread 0 in subgroup size 64 (Mip 3)
            SubgroupMergeDepths(threadID, 4, minDepth);
            SubgroupMergeDepths(threadID, 5, minDepth);
            if (g_Properties.minDstCount >= 4 && (threadID & 0x3F) == 0)
            {
                int2 dstCoord3 = dstCoord0 >> 3;
                if (all(dstCoord3 < (int2)g_Properties.dstSize23.zw))
                {
                    RWTexture2D<float> dstMip3 = GET_TEXTURE2D(g_Properties.dstUavMip3);
                    dstMip3[dstCoord3] = minDepth;
                }
            }
        }
    }

    cs "hlsl_block" : "CSMain";
}
