compute "Internal/OccludedMeshletCull"
{
    properties
    {
        uint hzbMipCount;
        uint renderWidth;
        uint renderHeight;
        uint visibleMeshletsUav;
        uint occludedMeshletsUav;
        uint counterBufferUav;
        uint maxVisibleMeshlets;
        uint hzbTexture;
        uint hzbBaseWidth;
        uint hzbBaseHeight;
    }

    includes
    {
        "EngineResources/Shaders/Includes/Properties.hlsl";
        "EngineResources/Shaders/Includes/CullCommon.hlsl";
    }

    hlsl
    {
        static inline bool TestHZB(float4 clipMin, float4 clipMax, InternalOccludedMeshletCullShaderProperties props)
        {
            return HZBVisible(
                clipMin,
                clipMax,
                props.hzbMipCount,
                props.renderWidth,
                props.renderHeight,
                props.hzbTexture,
                props.hzbBaseWidth,
                props.hzbBaseHeight);
        }

        [numthreads(64, 1, 1)]
        void CSMain(uint3 dispatchThreadId : SV_DispatchThreadID)
        {
            InternalOccludedMeshletCullShaderProperties props = LoadData<InternalOccludedMeshletCullShaderProperties>(g_PushConstantData.userData0, 0);

            RWByteAddressBuffer counterBuf = ResourceDescriptorHeap[props.counterBufferUav];
            uint occludedCount = counterBuf.Load(4);

            uint slotIndex = dispatchThreadId.x;
            bool isValid = (slotIndex < occludedCount);

            bool isVisible = false;
            MeshletCandidateRecord rec = (MeshletCandidateRecord)0;

            if (isValid)
            {
                StructuredBuffer<MeshletCandidateRecord> occludedBuffer = ResourceDescriptorHeap[props.occludedMeshletsUav];
                rec = occludedBuffer[slotIndex];

                InstanceData instance = LoadData<InstanceData>(g_FrameData.sceneBuffer, rec.instanceIndex);
                Meshlet meshlet = LoadData<Meshlet>(rec.meshletBufferIndex, rec.meshletIndex);

                BBoxFrustumResult cullResult = BBoxIntersectFrustum<false>(meshlet.boundingBoxMin, meshlet.boundingBoxMax, instance.localToWorld);
                if (cullResult.isVisible)
                {
                    if (cullResult.clipValid && props.hzbMipCount > 0)
                    {
                        isVisible = TestHZB(cullResult.clipMin, cullResult.clipMax, props);
                    }
                    else
                    {
                        isVisible = true;
                    }
                }
            }

            uint waveVisibleCount = WaveActiveCountBits(isVisible);
            uint localVisibleOffset = WavePrefixCountBits(isVisible);

            uint waveVisibleBase = 0;
            if (WaveIsFirstLane() && waveVisibleCount > 0)
            {
                counterBuf.InterlockedAdd(8, waveVisibleCount, waveVisibleBase);
            }
            waveVisibleBase = WaveReadLaneFirst(waveVisibleBase);

            if (isVisible)
            {
                uint slot = waveVisibleBase + localVisibleOffset;
                if (slot < props.maxVisibleMeshlets)
                {
                    RWStructuredBuffer<VisibleMeshletEntry> visibleBuffer = ResourceDescriptorHeap[props.visibleMeshletsUav];
                    VisibleMeshletEntry entry;
                    entry.instanceIndex = rec.instanceIndex;
                    entry.meshletIndex = rec.meshletIndex;
                    visibleBuffer[slot] = entry;
                }
            }
        }
    }

    cs "hlsl_block" : "CSMain";
}
