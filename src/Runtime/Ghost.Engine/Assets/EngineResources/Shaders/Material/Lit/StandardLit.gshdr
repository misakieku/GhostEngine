shader "Ghost/StandardLit" : "Lit"
{
    properties
    {
        float3 baseColor = float3(0.73, 0.73, 0.73);
        Texture2D baseColorMap;
        Texture2D normalMap;
        Texture2D ormMap;
        Sampler sampler;
        float roughness = 0.5;
        float metallic;
        float3 emissionColor;
        Texture2D emissionMap;
    }

    strategy "DEFERREDLIGHTING_STRATEGY" "StandardLitDeferredLighting" ("EngineResources/Shaders/Material/Lit/StandardLit.hlsl");

    strategy "DEFERREDTEXTURING_STRATEGY" "StandardLitDeferredTexturing"
    {
        #include "EngineResources/Shaders/Utilities/MaterialUtility.hlsl"

        struct StandardLitDeferredTexturing
        {
            static StandardLitDeferredTexturing Create()
            {
                return (StandardLitDeferredTexturing)0;
            }

            SurfaceData GetSurfaceData(MaterialContext ctx, MaterialProperties props)
            {
                SurfaceData surface = (SurfaceData)0;
                surface.shadingModel = SHADING_MODEL_ID;
                
                surface.albedo = props.baseColor;
                if (IS_VALID_TEXTURE(props.baseColorMap))
                {
                    surface.albedo *= SampleTexture2DGrad<float4>(props.baseColorMap, props.sampler, ctx.uv, ctx.ddx_uv, ctx.ddy_uv).rgb;
                }

                ApplyDoubleSidedFlipOrMirror(ctx, props.doubleSidedConstants);

                if (IS_VALID_TEXTURE(props.normalMap))
                {
                    float3 normalTS = SampleTexture2DGrad<float3>(props.normalMap, props.sampler, ctx.uv, ctx.ddx_uv, ctx.ddy_uv);
                    surface.normalWS = TransformTangentToWorldDoubleSided(normalTS, ctx, props.doubleSidedConstants);
                }
                else
                {
                    surface.normalWS = ctx.normalWS;
                }

                if (IS_VALID_TEXTURE(props.ormMap))
                {
                    float3 orm = SampleTexture2DGrad<float3>(props.ormMap, props.sampler, ctx.uv, ctx.ddx_uv, ctx.ddy_uv);
                    surface.occlusion = orm.r;
                    surface.roughness = orm.g;
                    surface.metallic = orm.b;
                }
                else
                {
                    surface.roughness = props.roughness;
                    surface.metallic = props.metallic;
                    surface.occlusion = 1.0f;
                }

                surface.emissive = props.emissionColor;
                if (IS_VALID_TEXTURE(props.emissionMap))
                {
                    surface.emissive *= SampleTexture2DGrad<float3>(props.emissionMap, props.sampler, ctx.uv, ctx.ddx_uv, ctx.ddy_uv);
                }

                return surface;
            }
        };
    }
}
