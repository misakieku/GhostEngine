compute "Internal/TileLightCulling"
{
    properties
    {
        uint depthTextureIndex;
        uint tileLightListUav;
        uint renderWidth;
        uint renderHeight;
        uint tilesX;
        uint tilesY;
    }

    includes
    {
        "EngineResources/Shaders/Properties.hlsl";
        "EngineResources/Shaders/Common.hlsl";
        "EngineResources/Shaders/Lighting/LightGridCommon.hlsl";
        "EngineResources/Shaders/Generated/GhostRenderPipeline.hlsl";
    }

    hlsl
    {
        #define MAX_COARSE_LIGHTS 64u

        groupshared uint s_MinDeviceZ;
        groupshared uint s_MaxDeviceZ;
        groupshared float s_MinViewZ;
        groupshared float s_MaxViewZ;
        groupshared float3 s_TileCenterRay;
        groupshared float s_HalfTileSizeAtZDistOne;

        groupshared uint s_CoarseLightCount;
        groupshared uint s_CoarseLightIndices[MAX_COARSE_LIGHTS];

        groupshared uint s_DoesLightIntersect[2];
        groupshared uint s_TileLightCount;
        groupshared uint s_TileLightIndices[63]; // Max lights: 32 DWORDS -> 63 lights

        template<uint DWORDS>
        void ClearTileLightList(RWByteAddressBuffer tileLightListUav, uint tileIndex, uint groupIndex)
        {
            if (groupIndex < DWORDS)
            {
                uint tileByteOffset = tileIndex * (DWORDS * 4u);
                tileLightListUav.Store(tileByteOffset + groupIndex * 4u, 0u);
            }
        }

        template<uint DWORDS>
        void WriteTileLightList(RWByteAddressBuffer tileLightListUav, uint tileIndex, uint groupIndex)
        {
            uint maxLights = 2u * DWORDS - 1u;
            uint clampedCount = min(s_TileLightCount, maxLights);
            uint tileByteOffset = tileIndex * (DWORDS * 4u);

            if (groupIndex == 0u)
            {
                uint firstLight = (clampedCount > 0u) ? s_TileLightIndices[0] : 0u;
                uint dword0 = (clampedCount & 0xFFFFu) | (firstLight << 16u);
                tileLightListUav.Store(tileByteOffset, dword0);
            }
            else if (groupIndex < DWORDS)
            {
                uint k = groupIndex;
                uint idxA = 2u * k - 1u;
                uint idxB = 2u * k;
                uint lightA = (idxA < clampedCount) ? s_TileLightIndices[idxA] : 0u;
                uint lightB = (idxB < clampedCount) ? s_TileLightIndices[idxB] : 0u;
                uint dwordK = (lightA & 0xFFFFu) | (lightB << 16u);
                tileLightListUav.Store(tileByteOffset + k * 4u, dwordK);
            }
        }

        // Ray-cone vs sphere intersection (Unity HDRP / DICE FPTL algorithm)
        bool DoesSphereOverlapTile(float3 dir, float halfTileSizeAtZDistOne, float3 sphCen, float sphRadiusIn)
        {
            float3 V = dir; // Ray direction down center of tile

            float3 maxZdir = float3(-sphCen.z * sphCen.x, -sphCen.z * sphCen.y, sphCen.x * sphCen.x + sphCen.y * sphCen.y);
            float len = length(maxZdir);
            float scalarProj = len > 0.0001f ? (maxZdir.z / len) : len;
            float offs = scalarProj * sphRadiusIn;

            // In Left-Hand camera space (+Z forward):
            float s = max(sphCen.z + offs, 0.0f);
            float sphRadius = sphRadiusIn + s * halfTileSizeAtZDistOne;

            float a = dot(V, V);
            float CdotV = dot(sphCen, V);
            float c = dot(sphCen, sphCen) - sphRadius * sphRadius;

            float fDescDivFour = CdotV * CdotV - a * c;

            return (c < 0.0f) || (fDescDivFour > 0.0f && CdotV > 0.0f);
        }

        [numthreads(FPTL_TILE_SIZE, FPTL_TILE_SIZE, 1)]
        void CSMain(
            uint3 dispatchThreadId : SV_DispatchThreadID,
            uint3 groupID : SV_GroupID,
            uint3 groupThreadId : SV_GroupThreadID,
            uint groupIndex : SV_GroupIndex)
        {
            InternalTileLightCullingShaderProperties props = LoadData<InternalTileLightCullingShaderProperties>(g_PushConstantData.userData0, 0);

            // Initialize shared memory
            if (groupIndex == 0u)
            {
                s_MinDeviceZ = 0xFFFFFFFFu;
                s_MaxDeviceZ = 0u;
                s_CoarseLightCount = 0u;
                s_TileLightCount = 0u;
                s_DoesLightIntersect[0] = 0u;
                s_DoesLightIntersect[1] = 0u;
            }

            GroupMemoryBarrierWithGroupSync();

            // Sample depth texture and find min/max device depth within tile
            uint2 pixelCoord = groupID.xy * FPTL_TILE_SIZE + groupThreadId.xy;
            float deviceDepth = 0.0f;
            bool hasValidDepth = false;

            if (pixelCoord.x < props.renderWidth && pixelCoord.y < props.renderHeight)
            {
                Texture2D<float> depthTexture = ResourceDescriptorHeap[props.depthTextureIndex];
                deviceDepth = depthTexture[pixelCoord];

                // In Reversed-Z: geometry is in (0.0, 1.0], while 0.0 is background/clear/sky
                if (deviceDepth > 0.0f)
                {
                    hasValidDepth = true;
                    uint depthUint = asuint(deviceDepth);
                    InterlockedMin(s_MinDeviceZ, depthUint);
                    InterlockedMax(s_MaxDeviceZ, depthUint);
                }
            }

            GroupMemoryBarrierWithGroupSync();

            uint tileIndex = groupID.y * props.tilesX + groupID.x;
            RWByteAddressBuffer tileLightListUav = ResourceDescriptorHeap[props.tileLightListUav];
            bool hasGeometry = (s_MinDeviceZ != 0xFFFFFFFFu);

            // If the tile has no geometry (all sky), clear light list and exit
            if (!hasGeometry)
            {
                ClearTileLightList<DWORDS_PER_TILE>(tileLightListUav, tileIndex, groupIndex);
                return;
            }

            // Thread 0 computes tile ray, depth range, and angular size in view space
            float n = g_ViewData.nearClip;
            float f = g_ViewData.farClip;
            float m00 = g_ViewData.projectionMatrix[0][0];
            float m11 = g_ViewData.projectionMatrix[1][1];

            if (groupIndex == 0u)
            {
                float minDevZ = asfloat(s_MinDeviceZ);
                float maxDevZ = asfloat(s_MaxDeviceZ);

                // Reversed-Z linear eye depth:
                // z_view = (near * far) / ((far - near) * z_dev + near)
                s_MinViewZ = max((n * f) / ((f - n) * maxDevZ + n), n);
                s_MaxViewZ = min((n * f) / ((f - n) * minDevZ + n), f);

                // Tile center pixel in NDC [-1, 1]
                float2 tileCenterPixel = float2(groupID.xy * FPTL_TILE_SIZE + (FPTL_TILE_SIZE / 2u));
                float2 tileCenterNDC = float2(
                    (tileCenterPixel.x * g_ViewData.screenSize.z) * 2.0f - 1.0f,
                    1.0f - (tileCenterPixel.y * g_ViewData.screenSize.w) * 2.0f
                );
                s_TileCenterRay = float3(tileCenterNDC.x / m00, tileCenterNDC.y / m11, 1.0f);

                // View-space tile half-size at Z = 1
                float dx = (2.0f * g_ViewData.screenSize.z) / m00;
                float dy = (2.0f * g_ViewData.screenSize.w) / m11;
                s_HalfTileSizeAtZDistOne = float(FPTL_TILE_SIZE / 2u) * length(float2(dx, dy));
            }

            GroupMemoryBarrierWithGroupSync();

            // Each thread reconstructs its pixel's view-space surface position
            float3 pixelPosVS = float3(0.0f, 0.0f, 0.0f);
            if (hasValidDepth)
            {
                float zView = (n * f) / ((f - n) * deviceDepth + n);
                float2 ndc = float2(
                    ((float(pixelCoord.x) + 0.5f) * g_ViewData.screenSize.z) * 2.0f - 1.0f,
                    1.0f - ((float(pixelCoord.y) + 0.5f) * g_ViewData.screenSize.w) * 2.0f
                );
                pixelPosVS = float3((ndc.x / m00) * zView, (ndc.y / m11) * zView, zView);
            }

            // Coarse culling (spherical ray-cone test + depth slice test)
            for (uint lightIndex = groupIndex; lightIndex < g_FrameData.punctualLightCount; lightIndex += 256u)
            {
                PunctualLightData light = LoadData<PunctualLightData>(g_FrameData.punctualLightsBuffer, lightIndex);
                float3 centerVS = mul(g_ViewData.viewMatrix, float4(light.positionWS, 1.0f)).xyz;
                float radius = light.range;

                if (centerVS.z + radius >= s_MinViewZ && centerVS.z - radius <= s_MaxViewZ)
                {
                    if (DoesSphereOverlapTile(s_TileCenterRay, s_HalfTileSizeAtZDistOne, centerVS, radius))
                    {
                        uint slot;
                        InterlockedAdd(s_CoarseLightCount, 1u, slot);
                        if (slot < MAX_COARSE_LIGHTS)
                        {
                            s_CoarseLightIndices[slot] = lightIndex;
                        }
                    }
                }
            }

            GroupMemoryBarrierWithGroupSync();

            // Fine pruning (per-pixel 3D Euclidean distance test against tile surface geometry)
            uint coarseCount = min(s_CoarseLightCount, MAX_COARSE_LIGHTS);
            uint uLightsFlags[2] = { 0u, 0u };

            if (hasValidDepth)
            {
                for (uint l = 0u; l < coarseCount; ++l)
                {
                    uint lightIndex = s_CoarseLightIndices[l];
                    PunctualLightData light = LoadData<PunctualLightData>(g_FrameData.punctualLightsBuffer, lightIndex);
                    float3 centerVS = mul(g_ViewData.viewMatrix, float4(light.positionWS, 1.0f)).xyz;
                    float radiusSq = light.range * light.range;

                    float3 toLight = centerVS - pixelPosVS;
                    if (dot(toLight, toLight) <= radiusSq)
                    {
                        uLightsFlags[l >> 5u] |= (1u << (l & 31u));
                    }
                }
            }

            if (uLightsFlags[0] != 0u)
            {
                InterlockedOr(s_DoesLightIntersect[0], uLightsFlags[0]);
            }
            if (uLightsFlags[1] != 0u)
            {
                InterlockedOr(s_DoesLightIntersect[1], uLightsFlags[1]);
            }

            GroupMemoryBarrierWithGroupSync();

            if (groupIndex == 0u)
            {
                uint count = 0u;
                for (uint w = 0u; w < 2u; ++w)
                {
                    uint mask = s_DoesLightIntersect[w];
                    while (mask != 0u && count < MAX_LIGHTS_PER_TILE)
                    {
                        uint bit = firstbitlow(mask);
                        mask &= ~(1u << bit);
                        s_TileLightIndices[count++] = s_CoarseLightIndices[w * 32u + bit];
                    }
                }
                s_TileLightCount = count;
            }
            GroupMemoryBarrierWithGroupSync();

            // Write packed tile light list to RWByteAddressBuffer
            WriteTileLightList<DWORDS_PER_TILE>(tileLightListUav, tileIndex, groupIndex);
        }
    }

    cs "hlsl_block" : "CSMain";
}
