compute "Internal/RisRayTrace"
{
    properties
    {
        uint depthTextureIndex;
        uint gbuffer1Index;
        uint risLightSamplesIndex;
        uint stbnTextureIndex;
        uint risShadowMaskUav;
        uint unresolvedRaysBufferSrv;
        uint counterBufferSrv;
        uint renderWidth;
        uint renderHeight;
        uint tlasIndex;
        uint viewId;
        uint frameIndex;
        float rayBias;
        float distanceRayBias;
        float directionalShadowRayLength;
    }

    includes
    {
        "EngineResources/Shaders/Properties.hlsl";
        "EngineResources/Shaders/Common.hlsl";
        "EngineResources/Shaders/Utilities/Random.hlsl";
        "EngineResources/Shaders/MaterialPipeline/GBufferPacking.hlsl";
        "EngineResources/Shaders/Lighting/RayTracingCommon.hlsl";
        "EngineResources/Shaders/Lighting/LightEvaluation.hlsl";
        "EngineResources/Shaders/Lighting/RisCommon.hlsl";
        "EngineResources/Shaders/Generated/GhostRenderPipeline.hlsl";
        "EngineResources/Shaders/Generated/GPULightData.hlsl";
    }

    hlsl
    {
        [numthreads(64, 1, 1)]
        void CSMain(uint3 dispatchThreadId : SV_DispatchThreadID)
        {
            uint rayIndex = dispatchThreadId.x;
            RWByteAddressBuffer counter = GET_BUFFER(g_Properties.counterBufferSrv);
            uint totalRays = counter.Load(0);
            if (rayIndex >= totalRays)
            {
                return;
            }

            RWByteAddressBuffer unresolvedRays = GET_BUFFER(g_Properties.unresolvedRaysBufferSrv);
            uint packedCoord = unresolvedRays.Load(rayIndex * 4u);
            uint2 pixelCoord = uint2(packedCoord & 0xFFF, (packedCoord >> 12) & 0xFFF);
            float traversedDist = ((packedCoord >> 24) & 0xFF) * (0.04f / 255.0f);

            Texture2D<float> depthTex = GET_TEXTURE2D(g_Properties.depthTextureIndex);
            float depth = depthTex[pixelCoord];

            Texture2D<uint2> risSamples = GET_TEXTURE2D(g_Properties.risLightSamplesIndex);
            RisLightSample sampleData = UnpackRisLightSample(risSamples[pixelCoord]);

            Texture2D<float4> gb1 = GET_TEXTURE2D(g_Properties.gbuffer1Index);
            float2 encNormal = gb1[pixelCoord].rg;

            float zView;
            float2 ndc;
            float3 positionRWS = ReconstructPositionRWS(pixelCoord, depth, zView, ndc);
            float3 normalWS = OctahedralDecode(encNormal);

            float2 rngSample = SampleStbn2D(g_Properties.stbnTextureIndex, pixelCoord, g_Properties.frameIndex);
            float normalBias = max(0.01f, lerp(g_Properties.rayBias, g_Properties.distanceRayBias, saturate(zView / g_ViewData.farClip)));
            float shadow = 1.0f;

            if (IsRisDirectionalLight(sampleData.lightIndex))
            {
                if (zView <= g_Properties.directionalShadowRayLength)
                {
                    uint dirIdx = GetRisRawLightIndex(sampleData.lightIndex);
                    GPUDirectionalLight dirLight = LoadData<GPUDirectionalLight>(g_FrameData.directionalLightBuffer, dirIdx);

                    float3 rayDirRWS;
                    float rayDist;
                    ComputeDirectionalSoftShadowRay(positionRWS, dirLight.directionWS, dirLight.angularDiameter, rngSample, g_Properties.directionalShadowRayLength, rayDirRWS, rayDist);

                    float3 rayOriginRWS = positionRWS + rayDirRWS * traversedDist;
                    ApplyPositionBias(rayOriginRWS, rayDirRWS, normalWS, normalBias);
                    float remainingDist = max(rayDist - traversedDist, 0.01f);
                    shadow = TraceRayQueryShadow(g_Properties.tlasIndex, rayOriginRWS, rayDirRWS, remainingDist, 0.01f);
                    shadow = lerp(1.0f, shadow, dirLight.shadowDimmer);
                }
            }
            else
            {
                GPUPunctualLight light = LoadData<GPUPunctualLight>(g_FrameData.punctualLightsBuffer, sampleData.lightIndex);
                float3 lightPosRWS = TransformAbsoluteWorldToCameraRelative(light.positionWS);
                float3 rayDirRWS;
                float rayDist;
                ComputeSoftShadowRay(positionRWS, lightPosRWS, light.size.x, rngSample, rayDirRWS, rayDist);

                float3 rayOriginRWS = positionRWS + rayDirRWS * traversedDist;
                ApplyPositionBias(rayOriginRWS, rayDirRWS, normalWS, normalBias);
                float remainingDist = max(rayDist - traversedDist, 0.01f);
                shadow = TraceRayQueryShadow(g_Properties.tlasIndex, rayOriginRWS, rayDirRWS, max(remainingDist - 0.02f, 0.01f), 0.01f);
                shadow = lerp(1.0f, shadow, light.shadowDimmer);
            }

            RWTexture2D<float> shadowMaskUav = GET_TEXTURE2D(g_Properties.risShadowMaskUav);
            shadowMaskUav[pixelCoord] = shadow;
        }
    }

    cs "hlsl_block" : "CSMain";
}
