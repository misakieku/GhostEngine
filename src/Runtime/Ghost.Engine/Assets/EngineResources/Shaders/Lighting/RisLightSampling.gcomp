compute "Internal/RisLightSampling"
{
    properties
    {
        uint depthTextureIndex;
        uint gbuffer0Index;
        uint gbuffer1Index;
        uint tileLightListBufferIndex;
        uint visibleLightHashHistoryBufferIndex;
        uint stbnTextureIndex;
        uint risLightSamplesUav;
        uint renderWidth;
        uint renderHeight;
        uint tilesPerRow;
        uint frameIndex;
    }

    includes
    {
        "EngineResources/Shaders/Properties.hlsl";
        "EngineResources/Shaders/Common.hlsl";
        "EngineResources/Shaders/MaterialPipeline/GBufferPacking.hlsl";
        "EngineResources/Shaders/Lighting/LightGridCommon.hlsl";
        "EngineResources/Shaders/Lighting/LightEvaluation.hlsl";
        "EngineResources/Shaders/Material/Lit/BSDF.hlsl";
        "EngineResources/Shaders/Utilities/Random.hlsl";
        "EngineResources/Shaders/Lighting/RisCommon.hlsl";
        "EngineResources/Shaders/Generated/GhostRenderPipeline.hlsl";
        "EngineResources/Shaders/Generated/GPULightData.hlsl";
    }

    hlsl
    {
        struct SharedCandidateLight
        {
            float3 positionRWS;
            float invRangeSq;
            float radianceLum;
            uint indexAndFlags;
            float3 directionWS;
            float spotAngleScale;
            float spotAngleOffset;
            float diffuseDimmer;
            float specularDimmer;
        };

        groupshared SharedCandidateLight s_lights[64];

        [numthreads(16, 16, 1)]
        void CSMain(uint3 dispatchThreadId : SV_DispatchThreadID, uint3 groupId : SV_GroupID, uint groupIndex : SV_GroupIndex)
        {
            uint2 pixelCoord = dispatchThreadId.xy;
            bool inBounds = (pixelCoord.x < g_Properties.renderWidth && pixelCoord.y < g_Properties.renderHeight);

            bool hasPunctual = IS_VALID_BUFFER(g_Properties.tileLightListBufferIndex) && IS_VALID_BUFFER(g_FrameData.punctualLightsBuffer);
            bool hasDirectional = IS_VALID_BUFFER(g_FrameData.directionalLightBuffer) && (g_FrameData.directionalLightCount > 0u);

            if (!hasPunctual && !hasDirectional)
            {
                if (inBounds)
                {
                    RWTexture2D<uint2> risLightSamples = GET_TEXTURE2D(g_Properties.risLightSamplesUav);
                    risLightSamples[pixelCoord] = PackRisLightSample(0xFFFFFFFF, 0.0f);
                }
                return;
            }

            uint lightCount = 0u;
            if (hasPunctual)
            {
                uint tileIndex = groupId.y * g_Properties.tilesPerRow + groupId.x;
                ByteAddressBuffer tileLightList = GET_BUFFER(g_Properties.tileLightListBufferIndex);
                lightCount = min(GetTileLightCount<DWORDS_PER_TILE>(tileLightList, tileIndex), MAX_LIGHTS_PER_TILE);
            }

            if (lightCount == 0u && !hasDirectional)
            {
                if (inBounds)
                {
                    RWTexture2D<uint2> risLightSamples = GET_TEXTURE2D(g_Properties.risLightSamplesUav);
                    risLightSamples[pixelCoord] = PackRisLightSample(0xFFFFFFFF, 0.0f);
                }
                return;
            }

            // Overlap per-pixel depth fetch with cooperative 16x16 tile light preloading into LDS
            Texture2D<float> depthTexture = GET_TEXTURE2D(g_Properties.depthTextureIndex);
            float depth = inBounds ? depthTexture[pixelCoord] : 0.0f;

            if (groupIndex < lightCount)
            {
                SharedCandidateLight entry = (SharedCandidateLight)0;
                entry.invRangeSq = -1.0f;

                uint tileIndex = groupId.y * g_Properties.tilesPerRow + groupId.x;
                ByteAddressBuffer tileLightList = GET_BUFFER(g_Properties.tileLightListBufferIndex);
                TileLightFetchResult fetch = FetchTileLight<DWORDS_PER_TILE>(tileLightList, tileIndex, groupIndex);
                if (fetch.valid)
                {
                    GPUPunctualLight src = LoadData<GPUPunctualLight>(g_FrameData.punctualLightsBuffer, fetch.lightIndex);
                    if (src.lightDimmer > 0.0f && any(src.color > 0.0f))
                    {
                        uint isSpot = ((src.lightTypeAndShadowSize & 0xFu) == GPULIGHT_TYPE_SPOT) ? 0x10000u : 0u;
                        entry.positionRWS = TransformAbsoluteWorldToCameraRelative(src.positionWS);
                        entry.invRangeSq = src.invRangeSq;
                        entry.radianceLum = Luminance(src.color * src.lightDimmer);
                        entry.indexAndFlags = (fetch.lightIndex & 0xFFFFu) | isSpot;
                        entry.directionWS = src.directionWS;
                        entry.spotAngleScale = src.spotAngleScale;
                        entry.spotAngleOffset = src.spotAngleOffset;
                        entry.diffuseDimmer = src.diffuseDimmer;
                        entry.specularDimmer = src.specularDimmer;
                    }
                }

                s_lights[groupIndex] = entry;
            }

            GroupMemoryBarrierWithGroupSync();

            if (!inBounds)
            {
                return;
            }

            RWTexture2D<uint2> risLightSamples = GET_TEXTURE2D(g_Properties.risLightSamplesUav);
            if (depth <= 0.0f)
            {
                risLightSamples[pixelCoord] = PackRisLightSample(0xFFFFFFFF, 0.0f);
                return;
            }

            float zView;
            float2 ndc;
            float3 positionRWS = ReconstructPositionRWS(pixelCoord, depth, zView, ndc);
            float3 V = GetWorldSpaceNormalizeViewDir(positionRWS);

            float2 stbn = SampleStbn2D(g_Properties.stbnTextureIndex, pixelCoord, g_Properties.frameIndex);

            // Reproject to t - 1 screen space to query Visible Light Hash history with stochastic bilinear tile offset
            uint4 historyHash = uint4(0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu, 0xFFFFFFFFu);
            bool hasValidHistory = false;

            if (IS_VALID_BUFFER(g_Properties.visibleLightHashHistoryBufferIndex))
            {
                float4 prevClip = mul(g_ViewData.preVPMatrix, float4(positionRWS, 1.0f));
                float prevInvW = (prevClip.w > 1e-4f) ? rcp(prevClip.w) : 0.0f;
                float2 prevScreenUV = float2(prevClip.x * prevInvW * 0.5f + 0.5f, 1.0f - (prevClip.y * prevInvW * 0.5f + 0.5f));
                hasValidHistory = (prevClip.w > 1e-4f) && all(prevScreenUV >= 0.0f) && all(prevScreenUV <= 1.0f);

                if (hasValidHistory)
                {
                    float2 tileJitter = frac(stbn + float2(0.61803399f, 0.38196601f)) - 0.5f;
                    float2 prevPixelCoord = prevScreenUV * float2(g_Properties.renderWidth, g_Properties.renderHeight) + tileJitter * 16.0f;
                    int2 maxTileCoord = int2(int(g_Properties.tilesPerRow) - 1, int((g_Properties.renderHeight + 15u) / 16u) - 1);
                    uint2 prevTileCoord = uint2(clamp(int2(floor(prevPixelCoord / 16.0f)), int2(0, 0), maxTileCoord));
                    uint prevTileIndex = prevTileCoord.y * g_Properties.tilesPerRow + prevTileCoord.x;
                    ByteAddressBuffer historyBuf = GET_BUFFER(g_Properties.visibleLightHashHistoryBufferIndex);
                    historyHash = historyBuf.Load4(prevTileIndex * 16u);
                }
            }

            Texture2D<float4> gb0Tex = GET_TEXTURE2D(g_Properties.gbuffer0Index);
            Texture2D<float4> gb1Tex = GET_TEXTURE2D(g_Properties.gbuffer1Index);
            float4 gb0 = gb0Tex[pixelCoord];
            float4 gb1 = gb1Tex[pixelCoord];

            float3 albedo = gb0.rgb;
            float metallic = gb0.a;
            float3 normalWS = OctahedralDecode(gb1.rg);
            float surfaceRoughness = gb1.b;
            float3 f0 = lerp(float3(0.04f, 0.04f, 0.04f), albedo, metallic);
            float3 diffuseWeight = max(albedo * (1.0f - metallic), 0.02f);
            float clampedNdotV = ClampNdotV(dot(normalWS, V));

            // Hoist surface-invariant scalar terms outside the candidate light loop
            float diffuseWeightLum = Luminance(diffuseWeight);
            float f0Lum = Luminance(f0);
            float roughness = max(surfaceRoughness * surfaceRoughness, 0.001f);
            float a2 = roughness * roughness;
            float a2Minus1 = a2 - 1.0f;

            // Unified streaming reservoir sampler (UE5 MegaLights style)
            struct LightSampler
            {
                float weightSum;
                uint winnerIndex;
                float winnerWeight;
                float rand;
            };

            LightSampler lightSampler = (LightSampler)0;
            lightSampler.winnerIndex = 0xFFFFFFFFu;
            lightSampler.rand = stbn.x;

            // 1. Sample Local Punctual Lights
            [loop]
            for (uint k = 0u; k < lightCount; ++k)
            {
                SharedCandidateLight cand = s_lights[k];
                if (cand.invRangeSq < 0.0f)
                {
                    continue;
                }

                // Early sphere-range and backface rejection BEFORE rsqrt(distSq)
                float3 unL = cand.positionRWS - positionRWS;
                float distSq = dot(unL, unL);
                float rangeFactor = distSq * cand.invRangeSq;
                if (rangeFactor >= 1.0f || dot(normalWS, unL) <= 0.0f)
                {
                    continue;
                }

                float invDist = rsqrt(max(distSq, 1e-8f));
                float3 L = unL * invDist;
                float clampedNdotL = saturate(dot(normalWS, L));

                float smoothFactor = saturate(1.0f - rangeFactor * rangeFactor);
                float attenuation = (smoothFactor * smoothFactor) / max(distSq, 0.0001f);
                if ((cand.indexAndFlags & 0x10000u) != 0u)
                {
                    float spotAtten = saturate(dot(-L, cand.directionWS) * cand.spotAngleScale + cand.spotAngleOffset);
                    attenuation *= spotAtten * spotAtten;
                }

                if (attenuation <= 0.0f)
                {
                    continue;
                }

                float lightRadianceLum = cand.radianceLum * attenuation;

                // Scalar Lambertian diffuse target term
                float diffTerm = (clampedNdotL * INV_PI) * (cand.diffuseDimmer * diffuseWeightLum);

                // Scalar simplified GGX specular target term
                float3 H = normalize(L + V);
                float NdotH = saturate(dot(normalWS, H));
                float LdotH = saturate(dot(L, H));

                float d = (NdotH * NdotH) * a2Minus1 + 1.0f;
                float D = a2 / max(PI * d * d, 1e-7f);
                float V_fast = rcp(4.0f * LdotH * LdotH + 0.001f);

                float xH = saturate(1.0f - LdotH);
                float xH2 = xH * xH;
                float F = f0Lum + (1.0f - f0Lum) * (xH2 * xH2 * xH);

                float specTerm = (F * D * V_fast) * clampedNdotL * cand.specularDimmer;

                float linearLum = lightRadianceLum * (diffTerm + specTerm);
                if (linearLum > 1e-6f)
                {
                    float pHat = log2(linearLum + 1.0f);

                    // History visibility check (MegaLights style: 10% weight for hidden lights, 40% on history miss)
                    if (IS_VALID_BUFFER(g_Properties.visibleLightHashHistoryBufferIndex))
                    {
                        uint h = PCGHash(cand.indexAndFlags & 0xFFFFu);
                        uint bit0 = h & 127u;
                        uint bit1 = (h >> 8u) & 127u;

                        bool test0 = (historyHash[bit0 >> 5u] & (1u << (bit0 & 31u))) != 0u;
                        bool test1 = (historyHash[bit1 >> 5u] & (1u << (bit1 & 31u))) != 0u;
                        if (!test0 || !test1)
                        {
                            pHat *= hasValidHistory ? 0.1f : 0.4f;
                        }
                    }

                    // Streaming reservoir update (AddLightSample)
                    float tau = lightSampler.weightSum / (lightSampler.weightSum + pHat);
                    lightSampler.weightSum += pHat;

                    if (lightSampler.rand >= tau)
                    {
                        lightSampler.winnerIndex = cand.indexAndFlags & 0xFFFFu;
                        lightSampler.winnerWeight = pHat;
                        lightSampler.rand = (lightSampler.rand - tau) / max(1.0f - tau, 1e-7f);
                    }
                    else
                    {
                        lightSampler.rand = lightSampler.rand / max(tau, 1e-7f);
                    }
                    lightSampler.rand = clamp(lightSampler.rand, 0.0f, 0.99999994f);
                }
            }

            float localWeightSum = lightSampler.weightSum;

            // 2. Sample Directional Lights (MegaLights Soft-Budget Clamped Stream)
            if (hasDirectional)
            {
                for (uint dirIdx = 0u; dirIdx < g_FrameData.directionalLightCount; ++dirIdx)
                {
                    GPUDirectionalLight dirLight = LoadData<GPUDirectionalLight>(g_FrameData.directionalLightBuffer, dirIdx);
                    if (dirLight.lightDimmer <= 0.0f || !any(dirLight.color > 0.0f))
                    {
                        continue;
                    }

                    float3 L = -dirLight.directionWS;
                    float clampedNdotL = saturate(dot(normalWS, L));
                    if (clampedNdotL <= 0.0f)
                    {
                        continue;
                    }

                    float diffTerm = (clampedNdotL * INV_PI) * (dirLight.diffuseDimmer * diffuseWeightLum);

                    float3 H = normalize(L + V);
                    float NdotH = saturate(dot(normalWS, H));
                    float LdotH = saturate(dot(L, H));

                    float minRough = (dirLight.angularDiameter > 0.0f) ? saturate(dirLight.angularDiameter * 0.5f) : 0.0f;
                    float dirRoughness = max(roughness, minRough * minRough);
                    float dirA2 = dirRoughness * dirRoughness;
                    float dirA2Minus1 = dirA2 - 1.0f;

                    float d = (NdotH * NdotH) * dirA2Minus1 + 1.0f;
                    float D = dirA2 / max(PI * d * d, 1e-7f);
                    float V_fast = rcp(4.0f * LdotH * LdotH + 0.001f);

                    float xH = saturate(1.0f - LdotH);
                    float xH2 = xH * xH;
                    float F = f0Lum + (1.0f - f0Lum) * (xH2 * xH2 * xH);

                    float specTerm = (F * D * V_fast) * clampedNdotL * dirLight.specularDimmer;

                    float dirRadianceLum = Luminance(dirLight.color * dirLight.lightDimmer);
                    float linearLum = dirRadianceLum * (diffTerm + specTerm);
                    if (linearLum > 1e-6f)
                    {
                        float pHat = log2(linearLum + 1.0f);

                        // MegaLights Directional Light Soft-Budget Clamping:
                        // Clamp base directional weight to the local light weight sum when local lights affect this pixel
                        // so directional light never starves local punctual lights, then apply history visibility guiding.
                        float sampleWeight = pHat;
                        if (localWeightSum > 0.0f)
                        {
                            sampleWeight = min(sampleWeight, max(localWeightSum, 0.001f));
                        }

                        if (IS_VALID_BUFFER(g_Properties.visibleLightHashHistoryBufferIndex))
                        {
                            uint h = PCGHash(RIS_LIGHT_TYPE_DIRECTIONAL_BIT | dirIdx);
                            uint bit0 = h & 127u;
                            uint bit1 = (h >> 8u) & 127u;

                            bool test0 = (historyHash[bit0 >> 5u] & (1u << (bit0 & 31u))) != 0u;
                            bool test1 = (historyHash[bit1 >> 5u] & (1u << (bit1 & 31u))) != 0u;
                            if (!test0 || !test1)
                            {
                                sampleWeight *= hasValidHistory ? 0.1f : 0.4f;
                            }
                        }

                        float tau = lightSampler.weightSum / (lightSampler.weightSum + sampleWeight);
                        lightSampler.weightSum += sampleWeight;

                        if (lightSampler.rand >= tau)
                        {
                            lightSampler.winnerIndex = RIS_LIGHT_TYPE_DIRECTIONAL_BIT | dirIdx;
                            lightSampler.winnerWeight = sampleWeight;
                            lightSampler.rand = (lightSampler.rand - tau) / max(1.0f - tau, 1e-7f);
                        }
                        else
                        {
                            lightSampler.rand = lightSampler.rand / max(tau, 1e-7f);
                        }
                        lightSampler.rand = clamp(lightSampler.rand, 0.0f, 0.99999994f);
                    }
                }
            }

            // 3. Finalize RIS Sample
            if (lightSampler.weightSum > 0.0f && lightSampler.winnerWeight > 0.0f)
            {
                float W = lightSampler.weightSum / lightSampler.winnerWeight;
                risLightSamples[pixelCoord] = PackRisLightSample(lightSampler.winnerIndex, W);
            }
            else
            {
                risLightSamples[pixelCoord] = PackRisLightSample(0xFFFFFFFF, 0.0f);
            }
        }
    }

    cs "hlsl_block" : "CSMain";
}
