shader "Hidden/DebugClassification"
{
    properties
    {
        uint variantTileListIndex;
        uint variantIndex;
        uint tilesPerRow;
        uint maxTilesPerVariant;
        uint renderWidth;
        uint renderHeight;
    }

    pass "Forward"
    {
        pipeline
        {
            ztest = disabled;
            zwrite = off;
            cull = off;
            blend = alpha;
            color_mask = all;
        }

        includes
        {
            "EngineResources/Shaders/Common.hlsl";
            "EngineResources/Shaders/Properties.hlsl";
            "EngineResources/Shaders/MaterialPipeline/ClassificationCommon.hlsl";
        }

        hlsl
        {
            struct PSInput
            {
                float4 position : SV_POSITION;
                float2 uv : TEXCOORD0;
                nointerpolation uint variantIndex : TEXCOORD1;
            };

            [numthreads(4, 1, 1)]
            [outputtopology("triangle")]
            void MSMain(
                uint gtid : SV_GroupThreadID,
                uint3 groupID : SV_GroupID,
                out vertices PSInput verts[4],
                out indices uint3 tris[2])
            {
                SetMeshOutputCounts(4, 2);

                HiddenDebugClassificationShaderProperties properties = LoadData<HiddenDebugClassificationShaderProperties>(g_PushConstantData.userData0, 0);

                ByteAddressBuffer tileList = ResourceDescriptorHeap[properties.variantTileListIndex];
                uint tileSlot = groupID.x;
                uint tileIndex = tileList.Load((properties.variantIndex * properties.maxTilesPerVariant + tileSlot) * 4u);
                uint2 tileCoord = DecodeTileCoord(tileIndex, properties.tilesPerRow);

                // Compute pixel extents for this 16x16 tile
                float2 minPixel = float2((float)(tileCoord.x * CLASSIFICATION_TILE_SIZE), (float)(tileCoord.y * CLASSIFICATION_TILE_SIZE));
                float2 maxPixel = minPixel + float2((float)CLASSIFICATION_TILE_SIZE, (float)CLASSIFICATION_TILE_SIZE);

                // Convert to NDC [-1, 1]
                float2 screenSize = float2((float)properties.renderWidth, (float)properties.renderHeight);
                float2 ndcMin = (minPixel / screenSize) * 2.0 - 1.0;
                float2 ndcMax = (maxPixel / screenSize) * 2.0 - 1.0;

                // Direct3D NDC Y is inverted (top is +1, bottom is -1)
                ndcMin.y = -ndcMin.y;
                ndcMax.y = -ndcMax.y;

                float2 uv = float2((float)(gtid & 1), (float)((gtid >> 1) & 1));
                float2 pos = float2(
                    lerp(ndcMin.x, ndcMax.x, uv.x),
                    lerp(ndcMin.y, ndcMax.y, uv.y)
                );

                verts[gtid].position = float4(pos, 0.0, 1.0);
                verts[gtid].uv = uv;
                verts[gtid].variantIndex = properties.variantIndex;

                if (gtid == 0)
                {
                    tris[0] = uint3(0, 1, 2);
                    tris[1] = uint3(1, 3, 2);
                }
            }

            float3 VariantToDebugColor(uint variant)
            {
                float hue = frac((float)variant * 0.618033988749895);
                float3 rgb = saturate(abs(fmod(hue * 6.0 + float3(0.0, 4.0, 2.0), 6.0) - 3.0) - 1.0);
                return rgb;
            }

            float4 PSMain(PSInput input) : SV_TARGET
            {
                uint2 pixelCoord = (uint2)input.position.xy;
                uint2 inTile = pixelCoord & (CLASSIFICATION_TILE_SIZE - 1u);
                bool isBorder = (inTile.x == 0u || inTile.x == (CLASSIFICATION_TILE_SIZE - 1u) ||
                                 inTile.y == 0u || inTile.y == (CLASSIFICATION_TILE_SIZE - 1u));

                if (isBorder)
                {
                    return float4(1.0, 1.0, 1.0, 0.85);
                }

                float3 color = VariantToDebugColor(input.variantIndex);
                return float4(color, 0.45);
            }
        }

        ms "hlsl_block" : "MSMain";
        ps "hlsl_block" : "PSMain";
    }
}
