shader "Internal/VisibilityBuffer"
{
    pass "Visibility"
    {
        pipeline
        {
            ztest = greater_equal;
            zwrite = on;
            cull = back;
            blend = opaque;
            color_mask = all;
        }

        includes
        {
            "EngineResources/Shaders/Includes/Properties.hlsl";
        }

        hlsl
        {
            struct PrimitiveOutput
            {
                uint primitiveID : SV_PrimitiveID;
            };

            struct VisibleMeshletEntry
            {
                uint instanceIndex;
                uint meshletIndex;
            };
            
            struct PixelInput
            {
                float4 position : SV_POSITION;
                nointerpolation uint packedVBufferX : TEXCOORD0;
                nointerpolation uint packedVBufferYBase : TEXCOORD1;
            };

            #define MS_THREADS 64

            [numthreads(MS_THREADS, 1, 1)]
            [outputtopology("triangle")]
            void MSMain(
                uint groupID : SV_GroupID,
                uint groupThreadID : SV_GroupThreadID,
                out vertices PixelInput outVerts[MAX_VERTICES_PER_MESHLET],
                out indices uint3 outTris[MAX_TRIANGLES_PER_MESHLET],
                out primitives PrimitiveOutput outPrims[MAX_TRIANGLES_PER_MESHLET])
            {
                uint visibleBufferIndex = g_PushConstantData.userData0 & 0x7FFFFFFFu;

                StructuredBuffer<VisibleMeshletEntry> visibleMeshlets = ResourceDescriptorHeap[visibleBufferIndex];
                VisibleMeshletEntry visible = visibleMeshlets[groupID];

                InstanceData instanceData = LoadData<InstanceData>(g_PushConstantData.userData1, visible.instanceIndex);
                MeshData meshData = LoadData<MeshData>(instanceData.meshBuffer, 0);
                Meshlet meshlet = LoadData<Meshlet>(meshData.meshletBuffer, visible.meshletIndex);

                uint vertexCount = meshlet.packedCounts & 0xFFu;
                uint triangleCount = (meshlet.packedCounts >> 8) & 0xFFu;
                uint localMaterialIndex = (meshlet.packedCounts >> 16) & 0xFFu;

                SetMeshOutputCounts(vertexCount, triangleCount);

                uint passBit = (g_PushConstantData.userData0 >> 31) & 1u;
                uint vbufferX = ((visible.instanceIndex + 1u) & 0x00FFFFFFu) | ((localMaterialIndex & 0xFFu) << 24);
                uint vbufferYBase = (visible.meshletIndex & 0x00FFFFFFu) | (passBit << 31);

                float4x4 worldViewProj = mul(g_ViewData.viewProjectionMatrix, instanceData.localToWorld);

                ByteAddressBuffer meshletVerticesBuffer = GET_BUFFER(meshData.meshletVerticesBuffer);
                ByteAddressBuffer meshletTrianglesBuffer = GET_BUFFER(meshData.meshletTrianglesBuffer);

                if (groupThreadID < vertexCount)
                {
                    uint vertexIndex = meshletVerticesBuffer.Load((meshlet.vertexOffset + groupThreadID) * 4);
                    ByteAddressBuffer vertices = GET_BUFFER(meshData.vertexBuffer);

                    // TODO: We only need the position data, maybe we can pack the position data into a separate buffer to reduce memory bandwidth usage.
                    uint vertexByteOffset = vertexIndex * 64 + 32;
                    float3 pos = asfloat(vertices.Load3(vertexByteOffset));

                    outVerts[groupThreadID].position = mul(worldViewProj, float4(pos, 1.0f));
                    outVerts[groupThreadID].packedVBufferX = vbufferX;
                    outVerts[groupThreadID].packedVBufferYBase = vbufferYBase;
                }

                if (groupThreadID < triangleCount)
                {
                    [unroll(2)]
                    for (uint i = groupThreadID; i < triangleCount; i += MS_THREADS)
                    {
                        uint packedIndices = meshletTrianglesBuffer.Load((meshlet.triangleOffset + i) * 4);
                        outTris[i] = uint3(packedIndices & 0xFF, (packedIndices >> 8) & 0xFF, (packedIndices >> 16) & 0xFF);
                        outPrims[i].primitiveID = i;
                    }
                }
            }

            uint2 PSMain(PixelInput input, uint primitiveID : SV_PrimitiveID) : SV_TARGET0
            {
                return uint2(
                    input.packedVBufferX,
                    input.packedVBufferYBase | ((primitiveID & 0x7Fu) << 24)
                );
            }
        }

        ms "hlsl_block" : "MSMain";
        ps "hlsl_block" : "PSMain";
    }
}