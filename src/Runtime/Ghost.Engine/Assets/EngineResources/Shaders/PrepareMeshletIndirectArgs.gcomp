compute "Internal/PrepareMeshletIndirectArgs"
{
    properties
    {
        uint counterBuffer;
        uint indirectArgsBuffer;
        uint opaqueCountOffset;
        uint opaqueArgsOffset;
        uint maskedCountOffset;
        uint maskedArgsOffset;
        uint maxCount;
    }

    includes
    {
        "EngineResources/Shaders/Includes/Properties.hlsl";
    }

    hlsl
    {
        [numthreads(2, 1, 1)]
        void CSMain(uint3 dispatchThreadID : SV_DispatchThreadID)
        {
            InternalPrepareMeshletIndirectArgsShaderProperties properties = LoadData<InternalPrepareMeshletIndirectArgsShaderProperties>(g_PushConstantData.propertiesBuffer, 0);

            RWByteAddressBuffer counterBuffer = ResourceDescriptorHeap[properties.counterBuffer];
            RWByteAddressBuffer indirectArgsBuffer = ResourceDescriptorHeap[properties.indirectArgsBuffer];

            if (dispatchThreadID.x == 0)
            {
                uint visibleCount = counterBuffer.Load(properties.opaqueCountOffset);
                if (visibleCount > properties.maxCount)
                {
                    visibleCount = properties.maxCount;
                }

                // D3D12_DISPATCH_MESH_ARGUMENTS: ThreadGroupCountX, ThreadGroupCountY, ThreadGroupCountZ
                indirectArgsBuffer.Store3(properties.opaqueArgsOffset, uint3(visibleCount, 1, 1));
            }
            else if (dispatchThreadID.x == 1)
            {
                uint visibleCount = counterBuffer.Load(properties.maskedCountOffset);
                if (visibleCount > properties.maxCount)
                {
                    visibleCount = properties.maxCount;
                }

                // D3D12_DISPATCH_MESH_ARGUMENTS: ThreadGroupCountX, ThreadGroupCountY, ThreadGroupCountZ
                indirectArgsBuffer.Store3(properties.maskedArgsOffset, uint3(visibleCount, 1, 1));
            }
        }
    }

    cs "hlsl_block" : "CSMain";
}
