shader "Internal/MeshletDebug"
{
    pass "Forward"
    {
        pipeline
        {
            ztest = greater_equal;
            zwrite = on;
            cull = back;
            blend = opaque;
            color_mask = all;
        }

        includes
        {
            "EngineResources/Shaders/Includes/Properties.hlsl";
            "EngineResources/Shaders/Includes/Random.hlsl";
        }

        hlsl
        {
            struct VisibleMeshletEntry
            {
                uint instanceIndex;
                uint meshletIndex;
            };

            struct PixelInput
            {
                float4 position : SV_POSITION;
                nointerpolation float3 color : COLOR0;
            };

            // Converts HSV to RGB for vibrant, distinct color visualization
            float3 HsvToRgb(float3 c)
            {
                float4 K = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
                float3 p = abs(frac(c.xxx + K.xyz) * 6.0 - K.www);
                return c.z * lerp(K.xxx, saturate(p - K.xxx), c.y);
            }

            float3 MeshletIdToColor(uint meshletIndex)
            {
                // Hash the meshlet index to a uniform hue using JenkinsHash from Random.hlsl
                uint h = JenkinsHash(meshletIndex * 1664525u + 1013904223u);
                float hue = frac(float(h) * (1.0 / 4294967296.0));
                return HsvToRgb(float3(hue, 0.75f, 0.95f));
            }

            [numthreads(128, 1, 1)]
            [outputtopology("triangle")]
            void MSMain(
                uint3 groupID : SV_GroupID,
                uint3 groupThreadID : SV_GroupThreadID,
                out vertices PixelInput outVerts[64],
                out indices uint3 outTris[124])
            {
                uint visibleBufferIndex = g_PushConstantData.instanceIndex & 0x7FFFFFFFu;

                StructuredBuffer<VisibleMeshletEntry> visibleMeshlets = ResourceDescriptorHeap[visibleBufferIndex];
                VisibleMeshletEntry visible = visibleMeshlets[groupID.x];

                FrameData frameData = LoadData<FrameData>(g_PushConstantData.frameBuffer, 0);
                InstanceData instanceData = LoadData<InstanceData>(frameData.instanceBuffer, visible.instanceIndex);
                MeshData meshData = LoadData<MeshData>(instanceData.meshBuffer, 0);

                ByteAddressBuffer meshletBuffer = GET_BUFFER(meshData.meshletBuffer);
                Meshlet meshlet = meshletBuffer.Load<Meshlet>(visible.meshletIndex * sizeof(Meshlet));

                uint vertexCount = meshlet.packedCounts & 0xFFu;
                uint triangleCount = (meshlet.packedCounts >> 8) & 0xFFu;

                SetMeshOutputCounts(vertexCount, triangleCount);

                float3 meshletColor = MeshletIdToColor(visible.meshletIndex);

                ViewData viewData = LoadData<ViewData>(g_PushConstantData.viewBuffer, 0);
                float4x4 worldViewProj = mul(viewData.viewProjectionMatrix, instanceData.localToWorld);

                ByteAddressBuffer meshletVerticesBuffer = GET_BUFFER(meshData.meshletVerticesBuffer);
                ByteAddressBuffer meshletTrianglesBuffer = GET_BUFFER(meshData.meshletTrianglesBuffer);

                if (groupThreadID.x < vertexCount)
                {
                    uint vertexIndex = meshletVerticesBuffer.Load((meshlet.vertexOffset + groupThreadID.x) * 4);
                    ByteAddressBuffer vertices = GET_BUFFER(meshData.vertexBuffer);

                    uint vertexByteOffset = vertexIndex * 64 + 32;
                    float3 pos = asfloat(vertices.Load3(vertexByteOffset));

                    outVerts[groupThreadID.x].position = mul(worldViewProj, float4(pos, 1.0f));
                    outVerts[groupThreadID.x].color = meshletColor;
                }

                if (groupThreadID.x < triangleCount)
                {
                    uint triangleIndex = groupThreadID.x;
                    uint packedIndices = meshletTrianglesBuffer.Load((meshlet.triangleOffset + triangleIndex) * 4);

                    outTris[triangleIndex] = uint3(
                        packedIndices & 0xFF,
                        (packedIndices >> 8) & 0xFF,
                        (packedIndices >> 16) & 0xFF);
                }
            }

            float4 PSMain(PixelInput input) : SV_TARGET0
            {
                return float4(input.color, 1.0f);
            }
        }

        ms "hlsl_block" : "MSMain";
        ps "hlsl_block" : "PSMain";
    }
}
